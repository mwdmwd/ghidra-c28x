<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/compiler_spec.rxg -->
<!-- pentry ordering:
- vector (not used)
- hiddenret (structure return pointer)
- ptr (pointers)
- float (floating-point)
- general (integers, structs, and fallback for exhausted pools)

See:
https://github.com/NationalSecurityAgency/ghidra/blob/aa094ab254d87abbd8431c14a0e46f2cb1ed3bdd/Ghidra/Features/Decompiler/src/decompile/cpp/fspec.cc#L1218-L1252
https://github.com/NationalSecurityAgency/ghidra/blob/aa094ab254d87abbd8431c14a0e46f2cb1ed3bdd/Ghidra/Features/Decompiler/src/decompile/cpp/type.hh#L131-L142
-->

<!-- SPRU514Z - JULY 2001 - REVISED OCTOBER 2023 -->
<compiler_spec>
  <data_organization>
    <char_size value="2" /> <!-- C28x byte is 16 bits -->
    <short_size value="2" />
    <integer_size value="2" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" /> <!-- EABI double is 64-bit -->
    <pointer_size value="4" />
  </data_organization>

  <global>
    <range space="ram"/>
  </global>

  <stackpointer register="SP" space="ram" growth="positive"/>

  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="2">
      <input>
        <!-- Class 3: Hidden Return Pointer (Structure returns) -->
        <!-- Placed in XAR6 (Manual Sec 7.3.2) -->
        <pentry minsize="1" maxsize="4" metatype="hiddenret">
          <register name="XAR6"/>
        </pentry>

        <!-- Class 2: Pointers -->
        <!-- Placed in XAR4 and XAR5 (Manual Sec 7.3.1) -->
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR4"/>
        </pentry>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR5"/>
        </pentry>

        <!-- Class 1: Floats -->
        <!-- 32-bit float arguments for FPU targets go to R0H-R3H -->
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R0H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R1H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R2H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R3H"/>
        </pentry>

        <!-- Class 0: General (Integers, structs, and fallback for exhausted pools) -->
        <!-- 32-bit integer arguments: First goes to ACC -->
        <pentry minsize="3" maxsize="4">
          <register name="ACC"/>
        </pentry>

        <!-- 16-bit integer arguments: Fill order is AL, AH, XAR4, XAR5 -->
        <pentry minsize="1" maxsize="2">
          <register name="AL"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="AH"/>
        </pentry>
        <!-- If XAR4/5 are not consumed by pointers, they act as general registers -->
        <pentry minsize="1" maxsize="2">
          <register name="XAR4"/>
        </pentry>
        <pentry minsize="1" maxsize="2">
          <register name="XAR5"/>
        </pentry>

        <!-- Any remaining arguments not placed in registers are pushed on the stack 
             offset="2" accounts for the 2-word RPC pushed at the top of the frame -->
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="2" space="stack"/>
        </pentry>
      </input>

      <output>
        <!-- Class 2: Pointers -->
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR4"/>
        </pentry>

        <!-- Class 1: Floats -->
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R0H"/>
        </pentry>

        <!-- Class 0: General -->
        <!-- 32-bit int returns in ACC -->
        <pentry minsize="3" maxsize="4">
          <register name="ACC"/>
        </pentry>
        <!-- 16-bit int returns in AL -->
        <pentry minsize="1" maxsize="2">
          <register name="AL"/>
        </pentry>
      </output>

      <unaffected>
        <!-- Registers preserved across function calls (Save on Entry conventions) -->
        <!-- Derived from Manual Table 7-2 & 7-3 -->
        <register name="XAR1"/>
        <register name="XAR2"/>
        <register name="XAR3"/>
        <register name="R4H"/>
        <register name="R5H"/>
        <register name="R6H"/>
        <register name="R7H"/>
        <register name="SP"/>
      </unaffected>
    </prototype>
  </default_proto>
</compiler_spec>
