<?xml version="1.0" encoding="UTF-8"?>

<!-- See Relax specification: Ghidra/Framework/SoftwareModeling/data/languages/compiler_spec.rxg -->
<!-- pentry ordering:
- vector (not used)
- hiddenret (structure return pointer)
- ptr (pointers)
- float (floating-point)
- general (integers, structs, and fallback for exhausted pools)

See:
https://github.com/NationalSecurityAgency/ghidra/blob/aa094ab254d87abbd8431c14a0e46f2cb1ed3bdd/Ghidra/Features/Decompiler/src/decompile/cpp/fspec.cc#L1218-L1252
https://github.com/NationalSecurityAgency/ghidra/blob/aa094ab254d87abbd8431c14a0e46f2cb1ed3bdd/Ghidra/Features/Decompiler/src/decompile/cpp/type.hh#L131-L142
-->

<!-- SPRU514Z - JULY 2001 - REVISED OCTOBER 2023 -->
<compiler_spec>
  <data_organization>
    <char_size value="2" /> <!-- C28x byte is 16 bits -->
    <short_size value="2" />
    <integer_size value="2" />
    <long_size value="4" />
    <long_long_size value="8" />
    <float_size value="4" />
    <double_size value="8" /> <!-- EABI double is 64-bit -->
    <pointer_size value="4" />
  </data_organization>

  <!--
    TI-generated C/C++ code assumes these status fields have their documented
    run-time-environment values at every function boundary (SPRU514, Table 7-4).
    The architectural PM field value 1 denotes "no product shift"; the SLEIGH
    PM register stores the decoded signed shift amount, so that boundary value
    is represented here as 0.
  -->
  <context_data>
    <tracked_set space="ram">
      <set name="PM" val="0" description="TI C run-time product shift: no shift"/>
      <set name="OVM" val="0" description="TI C run-time overflow mode disabled"/>
      <set name="PAGE0" val="0" description="TI C run-time direct/stack address mode"/>
    </tracked_set>
  </context_data>

  <global>
    <range space="ram"/>
  </global>

  <returnaddress>
    <register name="RPC"/>
  </returnaddress>

  <stackpointer register="SP" space="ram" growth="positive"/>

  <default_proto>
    <prototype name="__stdcall" extrapop="0" stackshift="2">
      <input>
        <!-- Class 3: Hidden return pointer (structure returns) -->
        <!-- Placed in XAR6 (manual sec 7.3.2) -->
        <pentry minsize="1" maxsize="4" storage="hiddenret">
          <register name="XAR6"/>
        </pentry>

        <!-- Class 2: Pointers -->
        <!-- Placed in XAR4 and XAR5 (Manual Sec 7.3.1) -->
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR4"/>
        </pentry>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR5"/>
        </pentry>

        <!-- Class 1: 32-bit floats go to R0H-R3H -->
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R0H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R1H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R2H"/>
        </pentry>
        <pentry minsize="3" maxsize="4" metatype="float">
          <register name="R3H"/>
        </pentry>

        <!-- Class 0: General: ACC covers both 16-bit and 32-bit integer args
            (AL/AH are sub-registers of ACC; listing them separately
              causes the physical-overlap error) -->
        <pentry minsize="1" maxsize="4">
          <register name="ACC"/>
        </pentry>

        <!-- Remaining arguments are pushed below the two-word RPC save on
             the positive-growing stack.  This reverse allocation range puts
             the first 32-bit stack argument at architectural *-SP[4]. -->
        <pentry minsize="1" maxsize="500" align="2">
          <addr offset="0x1fffffe08" space="stack"/>
        </pentry>
      </input>

      <output>
        <pentry minsize="1" maxsize="4" metatype="ptr">
          <register name="XAR4"/>
        </pentry>
        <pentry minsize="1" maxsize="4" metatype="float">
          <register name="R0H"/>
        </pentry>
        <!-- ACC covers both 32-bit and 16-bit integer returns (subsumes AL) -->
        <pentry minsize="1" maxsize="4">
          <register name="ACC"/>
        </pentry>
      </output>

      <unaffected>
        <!-- Registers preserved across function calls (Save on Entry conventions) -->
        <!-- Derived from Manual Table 7-2 & 7-3 -->
        <register name="XAR1"/>
        <register name="XAR2"/>
        <register name="XAR3"/>
        <register name="R4H"/>
        <register name="R5H"/>
        <register name="R6H"/>
        <register name="R7H"/>
        <register name="SP"/>
      </unaffected>

      <killedbycall>
        <register name="ACC"/>
        <register name="P"/>
        <register name="XT"/>
        <register name="XAR0"/>
        <register name="XAR4"/>
        <register name="XAR5"/>
        <register name="XAR6"/>
        <register name="XAR7"/>
        <register name="R0H"/>
        <register name="R1H"/>
        <register name="R2H"/>
        <register name="R3H"/>
        <register name="STF"/>
        <register name="DP"/>
        <register name="IFR"/>
        <register name="IER"/>
        <register name="DBGIER"/>
        <register name="ST0"/>
        <register name="ST1"/>
      </killedbycall>
    </prototype>
  </default_proto>
  <prototype name="interrupt" extrapop="0" stackshift="0">
    <input/>
    <output>
      <pentry minsize="1" maxsize="1">
        <register name="AL"/>
      </pentry>
    </output>
    <unaffected>
      <register name="SP"/>
      <register name="ACC"/>
      <register name="P"/>
      <register name="XT"/>
      <register name="XAR0"/>
      <register name="XAR1"/>
      <register name="XAR2"/>
      <register name="XAR3"/>
      <register name="XAR4"/>
      <register name="XAR5"/>
      <register name="XAR6"/>
      <register name="XAR7"/>
      <register name="DP"/>
      <register name="IER"/>
      <register name="ST0"/>
      <register name="ST1"/>
    </unaffected>
  </prototype>
</compiler_spec>
