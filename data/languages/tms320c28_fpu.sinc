################################################################
# SPRUEO2B - June 2007 - Revised January 2015
attach variables rah2 [ _ _ _ _ R0H R1H R2H R3H R4H R5H R6H R7H _ _ _ _ ];

# All FPU instructions have objmode=1
with : objmode=1 {

# p.86
:mov32 "mem32", "RaH" is op0_16=0b1110001000000011; op11_5=0b00000 {} # TODO mem32 rah

# p.90 (MOV32 RaH, ACC), p.93 (MOV32 RaH, P), p.96 (MOV32 RaH, XARn), p.97 (MOV32 RaH, XT)
:mov32 rah2, loc32 is op8_8=0b10111101 & loc32; op6_10=0b0000111100 & rah2 & op0_2=0b10 {}

# p.133
:setflg "FLAG_TODO", imm11 is op6_10=0b1110011000; imm11 {}

}
