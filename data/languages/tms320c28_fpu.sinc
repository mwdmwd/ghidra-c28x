	local e:4 = sext(s);
	rah3 = int2float(e);
}

# p.63 - no flags
:i16tof32 rah3_8, loc16 is op0_16=0b1110001011001000; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc16 {
