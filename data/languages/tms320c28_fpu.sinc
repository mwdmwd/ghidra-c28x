# SPRUHS1C p. 784 — TMU Type-0 multiply by the exact 1/(2*pi)
# single-precision constant.  Publication is 2p when consumed by SINPUF32,
# COSPUF32, or a memory store and 3p for other consumers.  The P-Code records
# the eventual result/LUF atomically; the verified schedules do not observe the
# destination or LUF before the documented publication point.
:div2pif32 rah3, rbh3 is op0_16=0b1110001001110001; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local operand_exp:4;
	local scale:4 = 0x3E22F983;
	local product:4;
	local product_exp:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	operand_exp = operand & 0x7F800000;
	product = operand f* scale;
	product_exp = product & 0x7F800000;
	local representable:1 = product_exp != 0;
	local representable_mask:4 = 0 - zext(representable);
	local underflow:1 = !representable && (operand_exp != 0);
	rah3 = product & representable_mask;
	STF_LU = STF_LU || underflow;
}

# SPRUHS1C pp. 785-786 — TMU Type-0 32-bit floating-point division.
# Hardware publishes the result and sticky LVF/LUF updates on cycle five.
# This instruction-level P-Code records the eventual architectural state
# atomically.  The retained compiler and firmware schedules have no result or
# LU/LV observer in the four intervening slots, so the collapse is equivalent
# there.  Cycle-accurate early TESTTF LU/LV observations remain deliberately
# outside this tranche; destructive STF operations in those slots are undefined.
:divf32 rah3, rbh3, rch3 is op0_16=0b1110001001110100; op9_7=0b0000000 & rch3 & rbh3 & rah3 {
	local numerator:4;
	local denominator:4;
	local numerator_exp:4;
	local denominator_exp:4;
	local result_sign:4;
	local infinity:4;

	# Snapshot and condition both sources before writing a possibly aliased RaH.
	tmu_condition_operand(numerator, rbh3);
	tmu_condition_operand(denominator, rch3);
	numerator_exp = numerator & 0x7F800000;
	denominator_exp = denominator & 0x7F800000;
	result_sign = (numerator ^ denominator) & 0x80000000;
	infinity = result_sign | 0x7F800000;

	local numerator_zero:1 = numerator_exp == 0;
	local numerator_infinity:1 = numerator_exp == 0x7F800000;
	local numerator_normal:1 = !numerator_zero && !numerator_infinity;
	local denominator_zero:1 = denominator_exp == 0;
	local denominator_infinity:1 = denominator_exp == 0x7F800000;
	local denominator_normal:1 = !denominator_zero && !denominator_infinity;
	local normal_division:1 = numerator_normal && denominator_normal;
	local normal_mask:4 = 0 - zext(normal_division);
	local safe_numerator:4 = numerator & normal_mask;
	local safe_denominator:4 = (denominator & normal_mask) | (0x3F800000 & ~normal_mask);
	local quotient:4 = safe_numerator f/ safe_denominator;
	local quotient_exp:4 = quotient & 0x7F800000;
	local quotient_underflow:1 = normal_division && (quotient_exp == 0);
	local quotient_overflow:1 = normal_division && (quotient_exp == 0x7F800000);

	local infinity_result:1 = numerator_infinity
		|| (numerator_normal && denominator_zero)
		|| quotient_overflow;
	local quotient_result:1 = normal_division && !quotient_underflow && !quotient_overflow;
	local infinity_mask:4 = 0 - zext(infinity_result);
	local quotient_mask:4 = 0 - zext(quotient_result);
	rah3 = (infinity & infinity_mask) | (quotient & quotient_mask);

	local overflow_event:1 = (numerator_zero && denominator_zero)
		|| (numerator_infinity && !denominator_infinity)
		|| (numerator_normal && denominator_zero)
		|| quotient_overflow;
	local underflow_event:1 = denominator_infinity || quotient_underflow;
	STF_LV = STF_LV || overflow_event;
	STF_LU = STF_LU || underflow_event;
}

# SPRUHS1C p. 787 — TMU Type-0 32-bit floating-point square root.
# Hardware publishes the result and sticky LVF update on cycle five.  As with
# DIVF32, this instruction-level P-Code records the eventual state atomically;
# early flag/result observation and overlapping pending operations remain
# outside the accepted scope.
:sqrtf32 rah3, rbh3 is op0_16=0b1110001001110111; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local operand_exp:4;
	local negative:1;
	local infinity_input:1;
	local ordinary:1;
	local ordinary_mask:4;
	local infinity_mask:4;
	local root:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	operand_exp = operand & 0x7F800000;
	negative = (operand & 0x80000000) != 0;
	infinity_input = operand_exp == 0x7F800000;
	ordinary = !negative && !infinity_input;
	ordinary_mask = 0 - zext(ordinary);
	infinity_mask = 0 - zext(!negative && infinity_input);
	local safe_operand:4 = operand & ordinary_mask;
	root = sqrt(safe_operand);
	rah3 = (root & ordinary_mask) | (0x7F800000 & infinity_mask);
	STF_LV = STF_LV || negative || (!negative && infinity_input);
}

# SPRUHS1C pp. 790-791 — TMU Type-0 cosine with a per-unit input.
# The range conditions and truncation-toward-zero fraction are explicit P-Code.
# cospu_f32 is an opaque, side-effect-free floating core for cos(fraction*2*pi),
# because standard P-Code has no trigonometric operator.  Result publication is
# 4p and remains represented as an atomic eventual write.
:cospuf32 rah3, rbh3 is op0_16=0b1110001001111001; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local magnitude:4;
	local integer_part:4;
	local integer_float:4;
	local fraction:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	magnitude = operand & 0x7FFFFFFF;
	local too_small:1 = magnitude <= 0x2F000000;
	local too_big:1 = magnitude >= 0x4A800000;
	local outside_range:1 = too_small || too_big;
	local outside_range_mask:4 = 0 - zext(outside_range);
	local core_operand:4 = operand & ~outside_range_mask;
	integer_part = trunc(core_operand);
	integer_float = int2float(integer_part);
	fraction = core_operand f- integer_float;
	local cosine:4 = cospu_f32(fraction);
	rah3 = (0x3F800000 & outside_range_mask) | (cosine & ~outside_range_mask);
}

