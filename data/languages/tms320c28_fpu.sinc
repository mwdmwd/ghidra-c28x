################################################################
# SPRUEO2B - June 2007 - Revised January 2015
attach variables rah2 [ _ _ _ _ R0H R1H R2H R3H R4H R5H R6H R7H _ _ _ _ ];  # this is weird
attach variables [ rah3 rbh3 rch3 rah3_8 ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];

@define fpu_imm16_add "imm6; fpu_imm10_lo [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ]"
@define fpu_imm16_cmp "imm3; fpu_imm13_lo [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ]"

# STF flags (Table 2-2 in SPRUEO2B)
define register offset=0x124 size=1  [  STF_LV  STF_LU  STF_NF  STF_ZF  STF_NI  STF_ZI  STF_TF  ];

cndf: "NEQ"  is cond0_4=0b0000 { local b:1 = (STF_ZF == 0); export b; }
cndf: "EQ"   is cond0_4=0b0001 { local b:1 = (STF_ZF == 1); export b; }
cndf: "GT"   is cond0_4=0b0010 { local b:1 = (STF_ZF == 0) && (STF_NF == 0); export b; }
cndf: "GEQ"  is cond0_4=0b0011 { local b:1 = (STF_NF == 0); export b; }
cndf: "LT"   is cond0_4=0b0100 { local b:1 = (STF_NF == 1); export b; }
cndf: "LEQ"  is cond0_4=0b0101 { local b:1 = (STF_ZF == 1) || (STF_NF == 1); export b; }
cndf: "TF"   is cond0_4=0b1010 { local b:1 = (STF_TF == 1); export b; }
cndf: "NTF"  is cond0_4=0b1011 { local b:1 = (STF_TF == 0); export b; }
cndf: "LU"   is cond0_4=0b1100 { local b:1 = (STF_LU == 1); export b; }
cndf: "LV"   is cond0_4=0b1101 { local b:1 = (STF_LV == 1); export b; }
cndf: "UNC"  is cond0_4=0b1110 { local b:1 = 1; export b; }                    # Unconditional
cndf: "UNCF" is cond0_4=0b1111 { local b:1 = 1; export b; }                    # Unconditional with flag modification

# p2_ee, p2_d3, p2_a3, p1_*, p2_rdh, p2_reh3 are defined on 'opcode' token in tms320c28.sinc
attach variables [ p2_d3 p2_a3 p2_rdh p2_reh3 ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];
attach variables [ p1_f3 ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];

# All FPU instructions have ctx_objmode=1
with : ctx_objmode=1 {

macro packstf(res) {
	local lv:4 = zext(STF_LV);
	local lu:4 = zext(STF_LU);
	local nf:4 = zext(STF_NF);
	local zf:4 = zext(STF_ZF);
	local ni:4 = zext(STF_NI);
	local zi:4 = zext(STF_ZI);
	local tf:4 = zext(STF_TF);
	res = (res & 0xFFFFFF80) | lv | (lu << 1) | (nf << 2) | (zf << 3) | (ni << 4) | (zi << 5) | (tf << 6);
}
macro unpackstf(in) {
	STF_LV = (in & 0x01) != 0;
	STF_LU = (in & 0x02) != 0;
	STF_NF = (in & 0x04) != 0;
	STF_ZF = (in & 0x08) != 0;
	STF_NI = (in & 0x10) != 0;
	STF_ZI = (in & 0x20) != 0;
	STF_TF = (in & 0x40) != 0;
}
macro packrb(res) {
	local rc:4 = zext(RB_RC);
	local re:4 = zext(RB_RE);
	local rsz:4 = zext(RB_RSIZE);
	local ra:4 = zext(RB_RA);
	local ras:4 = zext(RB_RAS);
	res = rc | (re << 16) | (rsz << 23) | (ra << 30) | (ras << 31);
}
macro unpackrb(in) {
	RB_RC    = in[0,16];
	RB_RE    = in[16,7];
	RB_RSIZE = in[23,7];
	RB_RA    = in[30,1];
	RB_RAS   = in[31,1];
}

fpu_re_low: "R0H" is p2_ee=0 { export R0H; }
fpu_re_low: "R1H" is p2_ee=1 { export R1H; }
fpu_re_low: "R2H" is p2_ee=2 { export R2H; }
fpu_re_low: "R3H" is p2_ee=3 { export R3H; }

fpu_re_high: "R4H" is p2_ee=0 { export R4H; }
fpu_re_high: "R5H" is p2_ee=1 { export R5H; }
fpu_re_high: "R6H" is p2_ee=2 { export R6H; }
fpu_re_high: "R7H" is p2_ee=3 { export R7H; }

macro update_stf(res) {
	STF_ZF = ((res & 0x7F800000) == 0);
	STF_NF = res[31,1] && (STF_ZF == 0);
}

macro fpu_cmp_operand(out, in) {
	local exp:4 = in & 0x7F800000;
	out = in;
	if (exp != 0) goto <not_zeroish>;
	out = 0;
	goto <done>;
	<not_zeroish>
	if (exp != 0x7F800000) goto <done>;
	if ((in & 0x007FFFFF) == 0) goto <done>;
	out = 0x7F800000;
	<done>
}

macro update_stf_cmp(lhs, rhs) {
	local lhs_cmp:4;
	local rhs_cmp:4;
	fpu_cmp_operand(lhs_cmp, lhs);
	fpu_cmp_operand(rhs_cmp, rhs);
	STF_ZF = (lhs_cmp f== rhs_cmp);
	STF_NF = (lhs_cmp f< rhs_cmp);
}

# TMU common input conditioning (SPRUHS1C section 7.5.2): negative zero
# and either-sign denormals become positive zero; NaNs become signed infinity.
macro tmu_condition_operand(out, in) {
	local exp:4 = in & 0x7F800000;
	if (exp != 0) goto <not_zeroish>;
	out = 0;
	goto <done>;
	<not_zeroish>
	out = in;
	if (exp != 0x7F800000) goto <done>;
	out = (in & 0x80000000) | 0x7F800000;
	<done>
}

macro fpu_minmax_output(out) {
	local exp:4 = out & 0x7F800000;
	if (exp != 0) goto <not_denorm>;
	if ((out & 0x007FFFFF) == 0) goto <done>;
	out = 0;
	goto <done>;
	<not_denorm>
	if (exp != 0x7F800000) goto <done>;
	if ((out & 0x007FFFFF) == 0) goto <done>;
	out = 0x7F800000;
	<done>
}

# MOV32/MOVD32 flag update: ZF/NF based on exponent field; also NI/ZI
macro update_stf_mov(res) {
	local zero_exp:1 = ((res & 0x7F800000) == 0);
	STF_NI = res[31,1];
	STF_ZI = (res == 0);
	STF_ZF = zero_exp;
	STF_NF = res[31,1] && !zero_exp;
}

# Parallel MOV32 store snapshots its source before the FPU side writes a possibly aliased register.
# Parallel MOV32 instructions - e=0 (R0H-R3H)
:addf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x1 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_low f+ p1_f3;
	loc32 = mov_src;
}
:addf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x1 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	p2_d3 = fpu_re_low f+ p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:subf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x2 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_low f- p1_f3;
	loc32 = mov_src;
}
:subf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x2 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	p2_d3 = fpu_re_low f- p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:mpyf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x0 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_low f* p1_f3;
	loc32 = mov_src;
}
:mpyf32 p2_d3, fpu_re_low, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x0 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	p2_d3 = fpu_re_low f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:macf32 "R3H, R2H," p2_d3, fpu_re_low, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x3 & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	R3H = R3H f+ R2H;
	p2_d3 = fpu_re_low f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}
:macf32 "R7H, R6H," p2_d3, fpu_re_low, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0xc & p1_f3 & p1_e=0; p2_d3 & loc32 & fpu_re_low & p2_a3 {
	R7H = R7H f+ R6H;
	p2_d3 = fpu_re_low f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

# Parallel MOV32 instructions - e=1 (R4H-R7H)
:addf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x1 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_high f+ p1_f3;
	loc32 = mov_src;
}
:addf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x1 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	p2_d3 = fpu_re_high f+ p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:subf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x2 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_high f- p1_f3;
	loc32 = mov_src;
}
:subf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x2 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	p2_d3 = fpu_re_high f- p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:mpyf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" loc32, p2_a3 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b00 & p1_fpu_op=0x0 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	local mov_src:4 = p2_a3;
	p2_d3 = fpu_re_high f* p1_f3;
	loc32 = mov_src;
}
:mpyf32 p2_d3, fpu_re_high, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x0 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	p2_d3 = fpu_re_high f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

:macf32 "R3H, R2H," p2_d3, fpu_re_high, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=0 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0x3 & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	R3H = R3H f+ R2H;
	p2_d3 = fpu_re_high f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}
:macf32 "R7H, R6H," p2_d3, fpu_re_high, p1_f3 "|| MOV32" p2_a3, loc32 is p1_op15_12=0b1110 & p1_mac_sel=1 & p1_op10=0 & p1_ls=0b11 & p1_fpu_op=0xc & p1_f3 & p1_e=1; p2_d3 & loc32 & fpu_re_high & p2_a3 {
	R7H = R7H f+ R6H;
	p2_d3 = fpu_re_high f* p1_f3;
	p2_a3 = loc32;
	update_stf_mov(p2_a3);
}

# p.70 — MACF32 R7H, R3H, mem32, *XAR7++
# LSW: 1110 0010 0101 0000 (fixed), MSW: 0001 1111 mem32
:macf32 "R7H, R3H," loc32^", *XAR7++" is op0_16=0b1110001001010000; op8_8=0b00011111 & loc32 {
	R3H = R3H f+ R2H;
	local v1:4 = loc32;
	local v2:4 = *:4 XAR7;
	XAR7 = XAR7 + 2;
	R2H = v1 f* v2;
}

# Parallel MAX/MIN
:maxf32 rah3, rbh3 "|| MOV32" rch3, p2_rdh is op0_16=0xe69c; op12_4=0 & p2_rdh & rch3 & rbh3 & rah3 {
	# Parallel sources are read before either destination is written. RdH is allowed
	# to alias RaH, so preserve it before MAXF32 potentially replaces RaH.
	local move_src:4 = p2_rdh;
	update_stf_cmp(rah3, rbh3);
	if (!STF_NF) goto <done>;
	rah3 = rbh3;
	rch3 = move_src;
	<done>
	fpu_minmax_output(rah3);
}
:minf32 rah3, rbh3 "|| MOV32" rch3, p2_rdh is op0_16=0xe69d; op12_4=0 & p2_rdh & rch3 & rbh3 & rah3 {
	# Parallel sources are read before either destination is written. RdH is allowed
	# to alias RaH, so preserve it before MINF32 potentially replaces RaH.
	local move_src:4 = p2_rdh;
	update_stf_cmp(rah3, rbh3);
	if (STF_NF) goto <done>;
	if (STF_ZF) goto <done>;
	rah3 = rbh3;
	rch3 = move_src;
	<done>
	fpu_minmax_output(rah3);
}

# p.86 MOV32 mem32, RaH (store)
:mov32 loc32, rah3_8 is op0_16=0b1110001000000011; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc32 {
	loc32 = rah3_8;
}

# p.90 (MOV32 RaH, ACC), p.93 (MOV32 RaH, P), p.96 (MOV32 RaH, XARn), p.97 (MOV32 RaH, XT)
:mov32 rah2, loc32 is op8_8=0b10111101 & loc32; op6_10=0b0000111100 & rah2 & op0_2=0b10 {
	rah2 = loc32;
}
# p.36
:absf32 rah3, rbh3 is op0_16=0b1110011010010101; op6_10=0b0000000000 & rbh3 & rah3 {
	rah3 = rbh3 & 0x7FFFFFFF;
	update_stf(rah3);
}

# p.41
:addf32 rah3, rbh3, rch3 is op0_16=0b1110011100010000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {
	rah3 = rbh3 f+ rch3;
}

# p.37 / p.39 (same encoding)
:addf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100010 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	rah3 = rbh3 f+ imm32;
}

# p.47
:cmpf32 rah3, rbh3 is op0_16=0b1110011010010100; op6_10=0b0000000000 & rbh3 & rah3 {
	update_stf_cmp(rah3, rbh3);
}

# p.50
:cmpf32 rah3, "#0.0" is op3_13=0b1110010110100 & rah3 {
	local zero:4 = 0;
	update_stf_cmp(rah3, zero);
}

# p.48
:cmpf32 rah3, #fpu_imm16 is op3_13=0b1110100000010 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	update_stf_cmp(rah3, imm32);
}

# p.51 - no flags (only LUF/LVF, which we don't model here)
:einvf32 rah3, rbh3 is op0_16=0b1110011010010011; op6_10=0b0000000000 & rbh3 & rah3 {
	local one:4 = 0x3F800000;
	rah3 = one f/ rbh3;
}

# p.53 - no flags (only LUF/LVF)
:eisqrtf32 rah3, rbh3 is op0_16=0b1110011010010010; op6_10=0b0000000000 & rbh3 & rah3 {
	local one:4 = 0x3F800000;
	rah3 = one f/ sqrt(rbh3);
}

# SPRUHS1C p. 784 — TMU Type-0 multiply by the exact 1/(2*pi)
# single-precision constant.  Publication is 2p when consumed by SINPUF32,
# COSPUF32, or a memory store and 3p for other consumers.  The P-Code records
# the eventual result/LUF atomically; the verified schedules do not observe the
# destination or LUF before the documented publication point.
:div2pif32 rah3, rbh3 is op0_16=0b1110001001110001; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local operand_exp:4;
	local scale:4 = 0x3E22F983;
	local product:4;
	local product_exp:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	operand_exp = operand & 0x7F800000;
	product = operand f* scale;
	product_exp = product & 0x7F800000;

	if (product_exp != 0) goto <representable>;
	# A conditioned zero input is an exact zero and does not underflow.  Any
	# nonzero input whose product is zero/subnormal is flushed to positive zero.
	if (operand_exp == 0) goto <exact_zero>;
	rah3 = 0;
	STF_LU = 1;
	goto <done>;

	<exact_zero>
	rah3 = 0;
	goto <done>;

	<representable>
	rah3 = product;
	<done>
}

# SPRUHS1C pp. 785-786 — TMU Type-0 32-bit floating-point division.
# Hardware publishes the result and sticky LVF/LUF updates on cycle five.
# This instruction-level P-Code records the eventual architectural state
# atomically.  The retained compiler and firmware schedules have no result or
# LU/LV observer in the four intervening slots, so the collapse is equivalent
# there.  Cycle-accurate early TESTTF LU/LV observations remain deliberately
# outside this tranche; destructive STF operations in those slots are undefined.
:divf32 rah3, rbh3, rch3 is op0_16=0b1110001001110100; op9_7=0b0000000 & rch3 & rbh3 & rah3 {
	local numerator:4;
	local denominator:4;
	local numerator_exp:4;
	local denominator_exp:4;
	local result_sign:4;
	local infinity:4;
	local quotient:4;
	local quotient_exp:4;

	# Snapshot and condition both sources before writing a possibly aliased RaH.
	tmu_condition_operand(numerator, rbh3);
	tmu_condition_operand(denominator, rch3);
	numerator_exp = numerator & 0x7F800000;
	denominator_exp = denominator & 0x7F800000;
	result_sign = (numerator ^ denominator) & 0x80000000;
	infinity = result_sign | 0x7F800000;

	if (numerator_exp != 0) goto <numerator_nonzero>;
	# 0 / 0 returns +0 and sets LVF; 0 / Inf returns +0 and sets LUF.
	if (denominator_exp != 0) goto <zero_denominator_nonzero>;
	rah3 = 0;
	STF_LV = 1;
	goto <done>;
	<zero_denominator_nonzero>
	if (denominator_exp != 0x7F800000) goto <zero_normal>;
	rah3 = 0;
	STF_LU = 1;
	goto <done>;
	<zero_normal>
	rah3 = 0;
	goto <done>;

	<numerator_nonzero>
	if (numerator_exp != 0x7F800000) goto <normal_numerator>;
	# Inf / Inf sets LUF; Inf / normal or zero sets LVF.
	rah3 = infinity;
	if (denominator_exp != 0x7F800000) goto <infinity_finite_denominator>;
	STF_LU = 1;
	goto <done>;
	<infinity_finite_denominator>
	STF_LV = 1;
	goto <done>;

	<normal_numerator>
	if (denominator_exp != 0) goto <denominator_nonzero>;
	rah3 = infinity;
	STF_LV = 1;
	goto <done>;
	<denominator_nonzero>
	if (denominator_exp != 0x7F800000) goto <normal_division>;
	rah3 = 0;
	STF_LU = 1;
	goto <done>;

	<normal_division>
	quotient = numerator f/ denominator;
	quotient_exp = quotient & 0x7F800000;
	if (quotient_exp != 0) goto <not_underflow>;
	# A zero/subnormal result is architectural underflow: flush to positive zero.
	rah3 = 0;
	STF_LU = 1;
	goto <done>;
	<not_underflow>
	if (quotient_exp != 0x7F800000) goto <finite_result>;
	# A generic FLOAT_DIV overflow may produce Inf (or NaN); TMU returns signed Inf.
	rah3 = infinity;
	STF_LV = 1;
	goto <done>;
	<finite_result>
	rah3 = quotient;
	<done>
}

# SPRUHS1C p. 787 — TMU Type-0 32-bit floating-point square root.
# Hardware publishes the result and sticky LVF update on cycle five.  As with
# DIVF32, this instruction-level P-Code records the eventual state atomically;
# early flag/result observation and overlapping pending operations remain
# outside the accepted scope.
:sqrtf32 rah3, rbh3 is op0_16=0b1110001001110111; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local operand_exp:4;
	local operand_sign:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	operand_exp = operand & 0x7F800000;
	operand_sign = operand & 0x80000000;

	# Conditioned negative zero/denormals are +0.  All remaining negative
	# finite values and -Inf return +0 and sticky-set LVF.
	if (operand_sign == 0) goto <nonnegative>;
	rah3 = 0;
	STF_LV = 1;
	goto <done>;

	<nonnegative>
	if (operand_exp != 0x7F800000) goto <finite>;
	# +Inf (including a conditioned positive NaN) returns +Inf and sets LVF.
	rah3 = 0x7F800000;
	STF_LV = 1;
	goto <done>;

	<finite>
	rah3 = sqrt(operand);
	<done>
}

# SPRUHS1C pp. 790-791 — TMU Type-0 cosine with a per-unit input.
# The range gates and truncation-toward-zero fraction are explicit P-Code.
# cospu_f32 is an opaque, side-effect-free floating core for cos(fraction*2*pi),
# because standard P-Code has no trigonometric operator.  Result publication is
# 4p and remains represented as an atomic eventual write.
:cospuf32 rah3, rbh3 is op0_16=0b1110001001111001; op6_10=0b0000000000 & rbh3 & rah3 {
	local operand:4;
	local magnitude:4;
	local integer_part:4;
	local integer_float:4;
	local fraction:4;

	# Snapshot and condition the source before writing a possibly aliased RaH.
	tmu_condition_operand(operand, rbh3);
	magnitude = operand & 0x7FFFFFFF;

	# The documented gates are inclusive: |x| <= 2^-33 or |x| >= 2^22.
	if (magnitude > 0x2F000000) goto <not_too_small>;
	rah3 = 0x3F800000;
	goto <done>;

	<not_too_small>
	if (magnitude < 0x4A800000) goto <core>;
	rah3 = 0x3F800000;
	goto <done>;

	<core>
	integer_part = trunc(operand);
	integer_float = int2float(integer_part);
	fraction = operand f- integer_float;
	rah3 = cospu_f32(fraction);
	<done>
}

# p.76
:maxf32 rah3, rbh3 is op0_16=0b1110011010010110; op6_10=0b0000000000 & rbh3 & rah3 {
	update_stf_cmp(rah3, rbh3);
	if (!STF_NF) goto <done>;
	rah3 = rbh3;
	<done>
	fpu_minmax_output(rah3);
}

# p.77
:maxf32 rah3, #fpu_imm16 is op3_13=0b1110100000100 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	update_stf_cmp(rah3, imm32);
	if (!STF_NF) goto <done>;
	rah3 = imm32;
	<done>
	fpu_minmax_output(rah3);
}

# p.79
:minf32 rah3, rbh3 is op0_16=0b1110011010010111; op6_10=0b0000000000 & rbh3 & rah3 {
	update_stf_cmp(rah3, rbh3);
	if (STF_NF) goto <done>;
	if (STF_ZF) goto <done>;
	rah3 = rbh3;
	<done>
	fpu_minmax_output(rah3);
}

# p.80
:minf32 rah3, #fpu_imm16 is op3_13=0b1110100000110 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	update_stf_cmp(rah3, imm32);
	if (STF_NF) goto <done>;
	if (STF_ZF) goto <done>;
	rah3 = imm32;
	<done>
	fpu_minmax_output(rah3);
}

# p.55 - no flags
:f32toi16 rah3, rbh3 is op0_16=0b1110011010001100; op6_10=0b0000000000 & rbh3 & rah3 {
	local t:4 = trunc(rbh3);
	local s:2 = t[0,16];
	rah3 = sext(s);
}

# p.56 - no flags
:f32toi16r rah3, rbh3 is op0_16=0b1110011010001100; op6_10=0b1000000000 & rbh3 & rah3 {
	local t:4 = round(rbh3);
	local s:2 = t[0,16];
	rah3 = sext(s);
}

# p.57 - no flags
:f32toi32 rah3, rbh3 is op0_16=0b1110011010001000; op6_10=0b0000000000 & rbh3 & rah3 {
	rah3 = trunc(rbh3);
}

# p.58 - no flags
:f32toui16 rah3, rbh3 is op0_16=0b1110011010001110; op6_10=0b0000000000 & rbh3 & rah3 {
	local zero:4 = 0;
	if (rbh3 f< zero) goto <negative>;
	local t:4 = trunc(rbh3);
	local s:2 = t[0,16];
	rah3 = zext(s);
	goto <done>;
	<negative>
	rah3 = 0;
	<done>
}

# p.59 - no flags
:f32toui16r rah3, rbh3 is op0_16=0b1110011010001110; op6_10=0b1000000000 & rbh3 & rah3 {
	local zero:4 = 0;
	if (rbh3 f< zero) goto <negative>;
	local t:4 = round(rbh3);
	local s:2 = t[0,16];
	rah3 = zext(s);
	goto <done>;
	<negative>
	rah3 = 0;
	<done>
}

# p.60 - no flags
:f32toui32 rah3, rbh3 is op0_16=0b1110011010001010; op6_10=0b0000000000 & rbh3 & rah3 {
	local zero:4 = 0;
	if (rbh3 f< zero) goto <negative>;
	rah3 = trunc(rbh3);
	goto <done>;
	<negative>
	rah3 = 0;
	<done>
}

# p.61 - no flags
:fracf32 rah3, rbh3 is op0_16=0b1110011011110001; op6_10=0b0000000000 & rbh3 & rah3 {
	local i:4 = trunc(rbh3);
	local int_part:4 = int2float(i);
	rah3 = rbh3 f- int_part;
}

# p.62 - no flags
:i16tof32 rah3, rbh3 is op0_16=0b1110011010001101; op6_10=0b0000000000 & rbh3 & rah3 {
