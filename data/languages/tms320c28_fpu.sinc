# p.144 - zero-extend to 64-bit so it stays non-negative, then narrow back to f32; no flags
:ui32tof32 rah3_8, loc32 is op0_16=0b1110001010000100; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc32 {
