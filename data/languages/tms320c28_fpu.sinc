:macf32 "R7H, R3H," loc32^", *XAR7++" is op0_16=0b1110001001010000; op8_8=0b00011111 & loc32 {
	R3H = R3H f+ R2H;
	local v1:4 = loc32;
	local v2:4 = *:4 XAR7;
	XAR7 = XAR7 + 2;
	R2H = v1 f* v2;
}

# Parallel MAX/MIN
:maxf32 rah3, rbh3 "|| MOV32" rch3, p2_rdh is op0_16=0xe69c; op12_4=0 & p2_rdh & rch3 & rbh3 & rah3 {
	# Parallel sources are read before either destination is written. RdH is allowed
	# to alias RaH, so preserve it before MAXF32 potentially replaces RaH.
	local move_src:4 = p2_rdh;
	update_stf_cmp(rah3, rbh3);
	if (!STF_NF) goto <done>;
	rah3 = rbh3;
	rch3 = move_src;
	<done>
	fpu_minmax_output(rah3);
}
:minf32 rah3, rbh3 "|| MOV32" rch3, p2_rdh is op0_16=0xe69d; op12_4=0 & p2_rdh & rch3 & rbh3 & rah3 {
	# Parallel sources are read before either destination is written. RdH is allowed
	# to alias RaH, so preserve it before MINF32 potentially replaces RaH.
	local move_src:4 = p2_rdh;
	update_stf_cmp(rah3, rbh3);
	if (STF_NF) goto <done>;
	if (STF_ZF) goto <done>;
	rah3 = rbh3;
	rch3 = move_src;
	<done>
	fpu_minmax_output(rah3);
}

