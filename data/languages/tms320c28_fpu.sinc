################################################################
# SPRUEO2B - June 2007 - Revised January 2015
attach variables rah2 [ _ _ _ _ R0H R1H R2H R3H R4H R5H R6H R7H _ _ _ _ ];  # this is weird
attach variables [ rah3 rbh3 rch3 rah3_8 ] [ R0H R1H R2H R3H R4H R5H R6H R7H ];

@define fpu_imm16_add "imm6; fpu_imm10_lo [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ]"
@define fpu_imm16_cmp "imm3; fpu_imm13_lo [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ]"

cndf: "NEQ"  is cndf4=0b0000 {}
cndf: "EQ"   is cndf4=0b0001 {}
cndf: "GT"   is cndf4=0b0010 {}
cndf: "GEQ"  is cndf4=0b0011 {}
cndf: "LT"   is cndf4=0b0100 {}
cndf: "LEQ"  is cndf4=0b0101 {}
cndf: "TF"   is cndf4=0b1010 {}
cndf: "NTF"  is cndf4=0b1011 {}
cndf: "LU"   is cndf4=0b1100 {}
cndf: "LV"   is cndf4=0b1101 {}
cndf: "UNC"  is cndf4=0b1110 {}
cndf: "UNCF" is cndf4=0b1111 {}

# All FPU instructions have objmode=1
with : objmode=1 {

# p.86 MOV32 mem32, RaH (store)
:mov32 loc32, rah3_8 is op0_16=0b1110001000000011; amode=0 & op11_5=0b00000 & rah3_8 & loc32 {}

# p.90 (MOV32 RaH, ACC), p.93 (MOV32 RaH, P), p.96 (MOV32 RaH, XARn), p.97 (MOV32 RaH, XT)
:mov32 rah2, loc32 is op8_8=0b10111101 & loc32; op6_10=0b0000111100 & rah2 & op0_2=0b10 {}

# p.36
:absf32 rah3, rbh3 is op0_16=0b1110011010010101; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.41
:addf32 rah3, rbh3, rch3 is op0_16=0b1110011100010000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {}

# p.37 / p.39 (same encoding)
:addf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100010 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {}

# p.47
:cmpf32 rah3, rbh3 is op0_16=0b1110011010010100; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.50
:cmpf32 rah3, "#0.0" is op3_13=0b1110010110100 & rah3 {}

# p.48
:cmpf32 rah3, #fpu_imm16 is op3_13=0b1110100000010 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {}

# p.51
:einvf32 rah3, rbh3 is op0_16=0b1110011010010011; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.53
:eisqrtf32 rah3, rbh3 is op0_16=0b1110011010010010; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.76
:maxf32 rah3, rbh3 is op0_16=0b1110011010010110; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.77
:maxf32 rah3, #fpu_imm16 is op3_13=0b1110100000100 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {}

# p.79
:minf32 rah3, rbh3 is op0_16=0b1110011010010111; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.80
:minf32 rah3, #fpu_imm16 is op3_13=0b1110100000110 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {}

# p.55
:f32toi16 rah3, rbh3 is op0_16=0b1110011010001100; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.56
:f32toi16r rah3, rbh3 is op0_16=0b1110011010001100; op6_10=0b1000000000 & rbh3 & rah3 {}

# p.57
:f32toi32 rah3, rbh3 is op0_16=0b1110011010001000; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.58
:f32toui16 rah3, rbh3 is op0_16=0b1110011010001110; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.59
:f32toui16r rah3, rbh3 is op0_16=0b1110011010001110; op6_10=0b1000000000 & rbh3 & rah3 {}

# p.60
:f32toui32 rah3, rbh3 is op0_16=0b1110011010001010; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.61
:fracf32 rah3, rbh3 is op0_16=0b1110011011110001; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.62
:i16tof32 rah3, rbh3 is op0_16=0b1110011010001101; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.63
:i16tof32 rah3_8, loc16 is op0_16=0b1110001011001000; amode=0 & op11_5=0b00000 & rah3_8 & loc16 {}

# p.64
:i32tof32 rah3_8, loc32 is op0_16=0b1110001010001000; amode=0 & op11_5=0b00000 & rah3_8 & loc32 {}

# p.65
:i32tof32 rah3, rbh3 is op0_16=0b1110011010001001; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.142
:ui16tof32 rah3_8, loc16 is op0_16=0b1110001011000100; amode=0 & op11_5=0b00000 & rah3_8 & loc16 {}

# p.143
:ui16tof32 rah3, rbh3 is op0_16=0b1110011010001111; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.144
:ui32tof32 rah3_8, loc32 is op0_16=0b1110001010000100; amode=0 & op11_5=0b00000 & rah3_8 & loc32 {}

# p.145
:ui32tof32 rah3, rbh3 is op0_16=0b1110011010001011; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.82
:mov16 loc16, rah3_8 is op0_16=0b1110001000010011; amode=0 & op11_5=0b00000 & rah3_8 & loc16 {}

# p.84 (MOV32 ACC, RaH), p.89 (MOV32 P, RaH), p.99 (MOV32 XARn, RaH), p.100 (MOV32 XT, RaH)
:mov32 loc32, rah2 is op8_8=0b10111111 & loc32; op6_10=0b0000111100 & rah2 & op0_2=0b10 {}

# p.83 (manual gives MOV32)
:vmov32 *(0:imm16), loc32 is op8_8=0b10111101 & loc32; imm16 {}

# p.85 (manual gives MOV32)
:vmov32 loc32, *(0:imm16) is op8_8=0b10111111 & loc32; imm16 {}

# p.88
:mov32 loc32, "STF" is op0_16=0b1110001000000000; amode=0 & op11_5=0b00000 & loc32 {}

# p.98
:mov32 "STF", loc32 is op0_16=0b1110001010000000; amode=0 & op11_5=0b00000 & loc32 {}

# p.91
:mov32 rah3_8, loc32, cndf is op4_12=0b111000101010 & cndf; amode=0 & op11_5=0b00000 & rah3_8 & loc32 {}

# p.94
:mov32 rah3, rbh3, cndf is op4_12=0b111001101100 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.101
:movd32 rah3_8, loc32 is op0_16=0b1110001000100011; amode=0 & op11_5=0b00000 & rah3_8 & loc32 {}

# p.104
:moviz rah3, #fpu_imm16 is op3_13=0b1110100000000 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {}

# p.106
:movxi rah3, #fpu_imm16 is op3_13=0b1110100000001 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {}

# p.106
:movst0 #imm8 is op8_8=0b10101101 & imm8 {}

# p.109
:mpyf32 rah3, rbh3, rch3 is op0_16=0b1110011100000000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {}

# p.110/111 (same encoding)
:mpyf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100001 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {}

# p.117
:negf32 rah3, rbh3, cndf is op4_12=0b111001101010 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.134
:subf32 rah3, rbh3, rch3 is op0_16=0b1110011100100000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {}

# p.135 (same encoding as SUBF32 imm)
:subf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100011 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {}

# p.121
:pop "RB" is op0_16=0b1111111111110001 {}

# p.123
:push "RB" is op0_16=0b1111111111110000 {}

# p.125
:restore is op0_16=0b1110010101100010 {}

# p.131
:save imm6, op11_5, imm11 is op6_10=0b1110011001 & imm6; op11_5 & imm11 {}

# p.140
:swapf rah3, rbh3, cndf is op4_12=0b111001101110 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {}

# p.141
:testtf cndf is op4_12=0b111001011000 & cndf {}

# p.146
:zero rah3 is op3_13=0b1110010110010 & rah3 {}

# p.147
:zeroa is op0_16=0b1110010101100011 {}

# p.133
:setflg imm6, op11_5, imm11 is op6_10=0b1110011000 & imm6; op11_5 & imm11 {}

}
