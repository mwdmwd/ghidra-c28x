################################################################

# All FPU instructions have objmode=1
with : objmode=1 {

# p.84
:mov32 "mem32", "RaH" is op0_16=0b1110001000000011; op11_5=0b00000 {} # TODO mem32 rah

# p.88
:mov32 "R0H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100010010 & ACC {}
:mov32 "R1H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100010110 & ACC {}
:mov32 "R2H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100011010 & ACC {}
:mov32 "R3H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100011110 & ACC {}
:mov32 "R4H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100100010 & ACC {}
:mov32 "R5H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100100110 & ACC {}
:mov32 "R6H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100101010 & ACC {}
:mov32 "R7H", ACC is op0_16=0b1011110110101001; op0_16=0b0000111100101110 & ACC {}

# p.128
:setflg "FLAG_TODO", imm11 is op6_10=0b1110011000; imm11 {}

}
