}

# p.84 (MOV32 ACC, RaH), p.89 (MOV32 P, RaH), p.99 (MOV32 XARn, RaH), p.100 (MOV32 XT, RaH)
:mov32 ACC, rah2 is op8_8=0b10111111 & op4_4=0b1010 & reg32=9 & ACC; op6_10=0b0000111100 & rah2 & op0_2=0b10 {
	ACC = rah2;
	flagnz(ACC);
}
:mov32 loc32, rah2 is op8_8=0b10111111 & loc32; op6_10=0b0000111100 & rah2 & op0_2=0b10 {
	loc32 = rah2;
}

# p.83 (manual gives MOV32)
:vmov32 *(0:imm16), loc32 is op8_8=0b10111101 & loc32; imm16 {
	local addr:4 = imm16;
	*:4 addr = loc32;
}

# p.85 (manual gives MOV32)
:vmov32 ACC, *(0:imm16) is op8_8=0b10111111 & op4_4=0b1010 & reg32=9 & ACC; imm16 {
	local addr:4 = imm16;
	ACC = *:4 addr;
	flagnz(ACC);
}
:vmov32 loc32, *(0:imm16) is op8_8=0b10111111 & loc32; imm16 {
	local addr:4 = imm16;
	loc32 = *:4 addr;
}

# p.88
:mov32 loc32, STF is op0_16=0b1110001000000000; ctx_amode=0 & op11_5=0b00000 & loc32 & STF {
	packstf(STF);
	loc32 = STF;
}

# p.98
:mov32 STF, loc32 is op0_16=0b1110001010000000; ctx_amode=0 & op11_5=0b00000 & loc32 & STF {
	STF = loc32;
