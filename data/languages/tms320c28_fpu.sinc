# p.142 - zext to 32-bit makes it a non-negative signed int, int2float is exact; no flags
:ui16tof32 rah3_8, loc16 is op0_16=0b1110001011000100; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc16 {
