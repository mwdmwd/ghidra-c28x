}

# p.91 - UNCF: always moves, updates NF/ZF/NI/ZI
:mov32 rah3_8, loc32, cndf is op4_12=0b111000101010 & cond0_4=0b1111 & cndf; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc32 {
	rah3_8 = loc32;
	update_stf_mov(rah3_8);
}

# p.91 - conditional (non-UNCF): no flags modified
:mov32 rah3_8, loc32, cndf is op4_12=0b111000101010 & cndf; ctx_amode=0 & op11_5=0b00000 & rah3_8 & loc32 {
	if (!cndf) goto <done>;
	rah3_8 = loc32;
	<done>
}

# p.94 - UNCF: always moves, updates NF/ZF/NI/ZI
:mov32 rah3, rbh3, cndf is op4_12=0b111001101100 & cond0_4=0b1111 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {
	rah3 = rbh3;
	update_stf_mov(rah3);
}

# p.94 - conditional (non-UNCF): no flags modified
:mov32 rah3, rbh3, cndf is op4_12=0b111001101100 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {
	if (!cndf) goto <done>;
	rah3 = rbh3;
	<done>
}

# p.101 - load RaH from mem32, copy mem32 to mem32+2
:movd32 rah3_8, mem32_addr is op0_16=0b1110001000100011; ctx_amode=0 & op11_5=0b00000 & rah3_8 & mem32_addr {
	local val:4 = *:4 mem32_addr;
	rah3_8 = val;
	*:4 (mem32_addr + 2) = val;
	update_stf_mov(rah3_8);
}

# p.104
:moviz rah3, #fpu_imm16 is op3_13=0b1110100000000 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {
	rah3 = fpu_imm16 << 16;
}

# p.106
:movxi rah3, #fpu_imm16 is op3_13=0b1110100000001 & imm3; fpu_imm13_lo & rah3 [ fpu_imm16 = (imm3 << 13) + fpu_imm13_lo; ] {
	# MOVXI replaces only RaH[15:0]; the upper half from a preceding MOVIZ is retained.
	rah3 = (rah3 & 0xFFFF0000) | zext(fpu_imm16:2);
}

# p.106 - copy selected STF flags to ST0; clear LUF/LVF if selected
:movst0 #imm8 is op8_8=0b10101101 & imm8 {
	local flag:4 = imm8;
	# MOVST0 uses LVF/LUF/NF/NI/ZF/ZI/CI/TF mask order, not STF bit order.
	# LVF/LUF -> OV, then clear selected latched flags.
	if ((flag & 0x03) == 0) goto <ov_done>;
	V = 0;
	if ((flag & 0x01) == 0) goto <lv_done>;
	if (STF_LV) goto <set_ov>;
	<lv_done>
	if ((flag & 0x02) == 0) goto <clear_latched>;
	if (!STF_LU) goto <clear_latched>;
	<set_ov>
	V = 1;
	<clear_latched>
	if ((flag & 0x01) == 0) goto <lu_clear>;
	STF_LV = 0;
	<lu_clear>
	if ((flag & 0x02) == 0) goto <ov_done>;
	STF_LU = 0;
	<ov_done>
	# NF/NI -> N
	if ((flag & 0x0c) == 0) goto <n_done>;
	N = 0;
	if ((flag & 0x04) == 0) goto <ni_check>;
	if (STF_NF) goto <set_n>;
	<ni_check>
	if ((flag & 0x08) == 0) goto <n_done>;
	if (!STF_NI) goto <n_done>;
	<set_n>
	N = 1;
	<n_done>
	# ZF/ZI -> Z
	if ((flag & 0x30) == 0) goto <z_done>;
	Z = 0;
	if ((flag & 0x10) == 0) goto <zi_check>;
	if (STF_ZF) goto <set_z>;
	<zi_check>
	if ((flag & 0x20) == 0) goto <z_done>;
	if (!STF_ZI) goto <z_done>;
	<set_z>
	Z = 1;
	<z_done>
	# CI -> C, TF -> TC
	if ((flag & 0x40) == 0) goto <f6_done>;
	C = STF_TF;
	<f6_done>
	if ((flag & 0x80) == 0) goto <f7_done>;
	TC = STF_TF;
	<f7_done>
}

# p.109
:mpyf32 rah3, rbh3, rch3 is op0_16=0b1110011100000000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {
	rah3 = rbh3 f* rch3;
}

# p.110/111 (same encoding)
:mpyf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100001 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	rah3 = rbh3 f* imm32;
}

# p.117 - UNCF: always negates, updates NF/ZF
:negf32 rah3, rbh3, cndf is op4_12=0b111001101010 & cond0_4=0b1111 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {
	rah3 = rbh3 ^ 0x80000000;
	update_stf(rah3);
}

# p.117 - conditional (non-UNCF): no flags modified
:negf32 rah3, rbh3, cndf is op4_12=0b111001101010 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {
	local val = rbh3;
	if (cndf) goto <true>;
	goto <done>;
	<true>
	val = rbh3 ^ 0x80000000;
	<done>
	rah3 = val;
}

# p.134
:subf32 rah3, rbh3, rch3 is op0_16=0b1110011100100000; op9_7=0b0000000 & rch3 & rbh3 & rah3 {
	rah3 = rbh3 f- rch3;
}

# p.135 (same encoding as SUBF32 imm)
:subf32 rah3, #fpu_imm16, rbh3 is op6_10=0b1110100011 & imm6; fpu_imm10_lo & rbh3 & rah3 [ fpu_imm16 = (imm6 << 10) + fpu_imm10_lo; ] {
	local imm32:4 = fpu_imm16 << 16;
	rah3 = imm32 f- rbh3;
}

# p.121
:pop RB is op0_16=0b1111111111110001 & RB {
	pop32(RB);
	unpackrb(RB);
}

# p.123
:push RB is op0_16=0b1111111111110000 & RB {
	packrb(RB);
	push32(RB);
}

# p.125
:restore is op0_16=0b1110010101100010 {
	R0H = R0H_sh;
	R1H = R1H_sh;
	R2H = R2H_sh;
	R3H = R3H_sh;
	R4H = R4H_sh;
	R5H = R5H_sh;
	R6H = R6H_sh;
	R7H = R7H_sh;
	STF = STF_sh;
	STF = STF & 0x7FFFFFFF;
	unpackstf(STF);
}

# p.131
:save imm6, imm11_5, imm11 is op6_10=0b1110011001 & imm6; imm11_5 & imm11 {
	R0H_sh = R0H;
	R1H_sh = R1H;
	R2H_sh = R2H;
	R3H_sh = R3H;
	R4H_sh = R4H;
	R5H_sh = R5H;
	R6H_sh = R6H;
	R7H_sh = R7H;
	packstf(STF);
	STF_sh = STF;
	local f_lo:4 = imm11_5;
	local f_hi:4 = imm6;
	local flag:4 = (f_hi << 5) | f_lo;
	local val:4 = imm11;
	STF = (STF & ~flag) | (val & flag);
	STF = STF | 0x80000000;
	unpackstf(STF);
}

# p.140 - no flags
:swapf rah3, rbh3, cndf is op4_12=0b111001101110 & cndf; op6_10=0b0000000000 & rbh3 & rah3 {
	if (!cndf) goto <done>;
	local tmp = rah3;
	rah3 = rbh3;
	rbh3 = tmp;
	<done>
}

# p.141
:testtf cndf is op4_12=0b111001011000 & cndf {
	STF_TF = cndf;
}

# p.146 - no flags
:zero rah3 is op3_13=0b1110010110010 & rah3 {
	rah3 = 0;
}

# p.147
:zeroa is op0_16=0b1110010101100011 {
	R0H = 0;
	R1H = 0;
	R2H = 0;
	R3H = 0;
}

# p.127
rptb_end: rel is imm7 [ rel = inst_start + imm7 + 2; rptb_flag=1; globalset(rel, rptb_flag); ] { export *:4 rel; }
:rptb rptb_end, loc16 is op8_8=0b10110101 & op7=0 & rptb_end & imm7; loc16 {
	local rsz:1 = imm7;
	RB_RSIZE = rsz;
	local count:2 = loc16;
	RB_RC = count;
	local end_addr:4 = (inst_start + zext(rsz) + 2) & 0x7F;
	RB_RE = end_addr[0,7];
	RB_RA = (count != 0);
	RB_RSTART = inst_next;
}

# p.129
:rptb rptb_end, #imm16 is op8_8=0b10110101 & op7=1 & rptb_end & imm7; imm16 {
	local rsz:1 = imm7;
	RB_RSIZE = rsz;
	local count:2 = imm16;
	RB_RC = count;
	local end_addr:4 = (inst_start + zext(rsz) + 2) & 0x7F;
	RB_RE = end_addr[0,7];
	RB_RA = (count != 0);
	RB_RSTART = inst_next;
}

# p.133
:setflg imm6, imm11_5, imm11 is op6_10=0b1110011000 & imm6; imm11_5 & imm11 {
	local f_lo:4 = imm11_5;
	local f_hi:4 = imm6;
	local flag:4 = (f_hi << 5) | f_lo;
	local val:4 = imm11;
	# bit 9 = RND32 rounding mode; bits 7-8,10 reserved (ignored)
	if ((flag & 0x200) == 0) goto <no_rnd>;
	STF = (STF & ~0x200) | (val & 0x200);
	<no_rnd>
	if ((flag & 0x01) == 0) goto <s0>; STF_LV = (val & 0x01) != 0; <s0>
	if ((flag & 0x02) == 0) goto <s1>; STF_LU = (val & 0x02) != 0; <s1>
	if ((flag & 0x04) == 0) goto <s2>; STF_NF = (val & 0x04) != 0; <s2>
	if ((flag & 0x08) == 0) goto <s3>; STF_ZF = (val & 0x08) != 0; <s3>
	if ((flag & 0x10) == 0) goto <s4>; STF_NI = (val & 0x10) != 0; <s4>
	if ((flag & 0x20) == 0) goto <s5>; STF_ZI = (val & 0x20) != 0; <s5>
	if ((flag & 0x40) == 0) goto <s6>; STF_TF = (val & 0x40) != 0; <s6>
}

# Subtables for RfH split across words: p1_f2 (LSW bits 1:0) = high 2 bits, p2_rfh_bit (MSW bit 15) = low bit
par_rfh_even: "R0H" is p1_f2=0 { export R0H; }
par_rfh_even: "R2H" is p1_f2=1 { export R2H; }
par_rfh_even: "R4H" is p1_f2=2 { export R4H; }
par_rfh_even: "R6H" is p1_f2=3 { export R6H; }

par_rfh_odd: "R1H" is p1_f2=0 { export R1H; }
par_rfh_odd: "R3H" is p1_f2=1 { export R3H; }
par_rfh_odd: "R5H" is p1_f2=2 { export R5H; }
par_rfh_odd: "R7H" is p1_f2=3 { export R7H; }

# p.114 MPYF32 RaH, RbH, RcH || ADDF32 RdH, ReH, RfH
:mpyf32 rah3, rbh3, rch3 "|| ADDF32" p2_rdh, p2_reh3, par_rfh_even is op3_13=0b1110011101000 & par_rfh_even; rah3 & rbh3 & rch3 & p2_rdh & p2_reh3 & p2_rfh_bit=0 {
	local mul_lhs:4 = rbh3;
	local mul_rhs:4 = rch3;
	local add_lhs:4 = p2_reh3;
	local add_rhs:4 = par_rfh_even;
	local mul_result:4 = mul_lhs f* mul_rhs;
	local add_result:4 = add_lhs f+ add_rhs;
	rah3 = mul_result;
	p2_rdh = add_result;
}

:mpyf32 rah3, rbh3, rch3 "|| ADDF32" p2_rdh, p2_reh3, par_rfh_odd is op3_13=0b1110011101000 & par_rfh_odd; rah3 & rbh3 & rch3 & p2_rdh & p2_reh3 & p2_rfh_bit=1 {
	local mul_lhs:4 = rbh3;
	local mul_rhs:4 = rch3;
	local add_lhs:4 = p2_reh3;
	local add_rhs:4 = par_rfh_odd;
	local mul_result:4 = mul_lhs f* mul_rhs;
	local add_result:4 = add_lhs f+ add_rhs;
	rah3 = mul_result;
	p2_rdh = add_result;
}

# p.119 MPYF32 RaH, RbH, RcH || SUBF32 RdH, ReH, RfH
:mpyf32 rah3, rbh3, rch3 "|| SUBF32" p2_rdh, p2_reh3, par_rfh_even is op3_13=0b1110011101010 & par_rfh_even; rah3 & rbh3 & rch3 & p2_rdh & p2_reh3 & p2_rfh_bit=0 {
	local mul_lhs:4 = rbh3;
	local mul_rhs:4 = rch3;
	local sub_lhs:4 = p2_reh3;
	local sub_rhs:4 = par_rfh_even;
	local mul_result:4 = mul_lhs f* mul_rhs;
	local sub_result:4 = sub_lhs f- sub_rhs;
	rah3 = mul_result;
	p2_rdh = sub_result;
}

:mpyf32 rah3, rbh3, rch3 "|| SUBF32" p2_rdh, p2_reh3, par_rfh_odd is op3_13=0b1110011101010 & par_rfh_odd; rah3 & rbh3 & rch3 & p2_rdh & p2_reh3 & p2_rfh_bit=1 {
	local mul_lhs:4 = rbh3;
	local mul_rhs:4 = rch3;
	local sub_lhs:4 = p2_reh3;
	local sub_rhs:4 = par_rfh_odd;
	local mul_result:4 = mul_lhs f* mul_rhs;
	local sub_result:4 = sub_lhs f- sub_rhs;
	rah3 = mul_result;
	p2_rdh = sub_result;
}

