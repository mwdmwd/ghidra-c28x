define token opcode (16)
	op0_16		= (0,15)
	op4_12		= (4,15)
	op8_8		= (8,15)
	op9_7		= (9,15)
	ax8			= (8,8)
	op12_4		= (12,15)

	shift4		= (0,3)
	loc16		= (0,7)
;

define token lopcode (16)
	lop0_16		= (0,15)
	lop8_8		= (8,15)
	lop12_4		= (12,15)

	lshift4		= (8,11)
	lloc16		= (0,7)

	limm16		= (0,15)
	lsimm16		= (0,15) signed
;

attach variables ax8 [ AL AH ];

################################################################
# Macros
################################################################

macro push16(val16) {
	SP = SP - 2;
	*:2 SP = val16;
}

macro pop16(ret16) {
	ret16 = *:2 SP;
	SP = SP + 2;
}

macro push8(val8) {
	SP = SP - 1;
	ptr:2 = SP;
	*:1 ptr = val8;
}

macro pop8(ret8) {
	ptr:2 = SP;
	ret8 = *:1 ptr;
	SP = SP + 1;
}

################################################################
# Addressing and stuff
################################################################

Mloc16: lloc16 is lloc16 { tmp:1 = lloc16; export tmp; }

################################################################

# p.124
:aborti is op0_16=0b0000000000000001 {}

# p.125
:abs ACC is op0_16=0b1111111101010110 & ACC {}

# p.126
:abstc ACC is op0_16=0b0101011001011111 & objmode=1 & ACC {}

# p.128
:add ACC, #limm16 << #shift4 is op4_12=0b111111110001 & ACC & shift4; limm16 {}  # sxm

# p.129
:add ACC, Mloc16 << T is op0_16=0b0101011000100011 & objmode=1 & ACC & T; lop8_8=0 & Mloc16 {} # TODO loc16!

# p.130
:add ACC, loc16 is op8_8=0b10000001 & objmode=1 & ACC & loc16 {} # TODO loc16!

# p.130
:add ACC, loc16 << #16 is op8_8=0b10000101 & ACC & loc16 {} # TODO loc16!

# p.130
:add ACC, loc16 << #shift4 is op12_4=0b1010 & objmode=0 & ACC & loc16 & shift4 {} # TODO loc16!

# p.130
:add ACC, lloc16 << #lshift4 is op0_16=0b0101011000000100; lop12_4=0b0000 & objmode=1 & ACC & lloc16 & lshift4 {} # TODO loc16!

# p.131
:add ax8, loc16 is op9_7=0b1001010 & ax8 & loc16 {}

# p.132
:add loc16, ax8 is op9_7=0b0111001 & ax8 & loc16 {}