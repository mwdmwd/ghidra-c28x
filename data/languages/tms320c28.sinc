# p.434; SPRU430F SUBUL ACC uses unsigned borrow-counting OVCU.
:subul ACC, loc32 is ctx_objmode=1 & op0_16=0b0101011001010101; op8_8=0b00000000 & ACC & loc32 {
	local value:4 = loc32;
	sub_unsigned32(ACC, value);
}

# p.435; SPRU430F SUBUL P uses unsigned borrow-counting OVCU.
:subul P, loc32 is op0_16=0b0101011001011101; op8_8=0b00000000 & P & loc32 {
	local value:4 = loc32;
	sub_unsigned32(P, value);
}

# p.436
:tbit loc16, #imm8_4 is op12_4=0b0100 & imm8_4 & loc16 {
