:clrc AMODE is op0_16=0b0101011000010110 & AMODE [ ctx_amode=0; globalset(inst_next, ctx_amode); ] {
	AMODE = 0;
}

# p.405, p.169 (C28MAP)
:setc M0M1MAP is op0_16=0b0101011000011010 & M0M1MAP {
	M0M1MAP = 1;
}

# p.406, p.170 (C28OBJ)
:setc OBJMODE is op0_16=0b0101011000011111 & OBJMODE {
	OBJMODE = 1;
}

# p.174, p.471 (ZAP OVC)
:clrc OVC is ctx_objmode=1 & op0_16=0b0101011001011100 & OVC {
	OVC = 0;
}

# p.175
:clrc XF is op0_16=0b0101011000011011 & XF {
	XF = 0;
}

# p.176
:clrc imm8 is op8_8=0b00101001 & page0_bit=0 & imm8 {
	local bimm8:1 = imm8;
	SXM   = SXM   && (bimm8[0,1] == 0);
	OVM   = OVM   && (bimm8[1,1] == 0);
	TC    = TC    && (bimm8[2,1] == 0);
	C     = C     && (bimm8[3,1] == 0);
	INTM  = INTM  && (bimm8[4,1] == 0);
	DBGM  = DBGM  && (bimm8[5,1] == 0);
	PAGE0 = PAGE0 && (bimm8[6,1] == 0);
	VMAP  = VMAP  && (bimm8[7,1] == 0);
}
:clrc imm8 is op8_8=0b00101001 & page0_bit=1 & imm8 [ ctx_page0=0; globalset(inst_next, ctx_page0); ] {
	local bimm8:1 = imm8;
	SXM   = SXM   && (bimm8[0,1] == 0);
	OVM   = OVM   && (bimm8[1,1] == 0);
	TC    = TC    && (bimm8[2,1] == 0);
	C     = C     && (bimm8[3,1] == 0);
	INTM  = INTM  && (bimm8[4,1] == 0);
	DBGM  = DBGM  && (bimm8[5,1] == 0);
	PAGE0 = PAGE0 && (bimm8[6,1] == 0);
	VMAP  = VMAP  && (bimm8[7,1] == 0);
}

# p.177.  CMP determines the sign as though the subtraction had infinite
# precision.  That sign is exactly the signed ordering predicate, while C is
# the independent unsigned no-borrow predicate.
:cmp ax8, loc16 is op9_7=0b0101010 & ax8 & loc16 {
	local loc:2 = loc16;
	N = ax8 s< loc;
	Z = ax8 == loc;
	C = ax8 >= loc;
}

# p.178
:cmp loc16, #simm16 is op8_8=0b00011011 & loc16; simm16 {
	local loc:2 = loc16;
	local immediate:2 = simm16:2;
	N = loc s< immediate;
	Z = loc == immediate;
	C = loc >= immediate;
}

# p.179
:cmp64 ACC:P is ctx_objmode=1 & op0_16=0b0101011001011110 & ACC & P {
	N = ACC[31, 1] ^ V;
	local lo:8 = zext(P);
	local hi:8 = zext(ACC);
	Z = ((hi << 32) | lo) == 0;
	V = 0;
}

# p.180
:cmpb ax8, #imm8 is op9_7=0b0101001 & ax8 & imm8 {
	local immediate:2 = zext(imm8:1);
	N = ax8 s< immediate;
	Z = ax8 == immediate;
	C = ax8 >= immediate;
}

# p.181
:cmpl ACC, loc32 is op8_8=0b00001111 & ACC & loc32 {
	local loc:4 = loc32;
	N = ACC s< loc;
	Z = ACC == loc;
	C = ACC >= loc;
}

# p.182
:cmpl ACC, P << PM is op0_16=0b1111111101011001 & ACC & P & PM {
	local shifted:4;
	pmshift(shifted, P);
	N = ACC s< shifted;
	Z = ACC == shifted;
	C = ACC >= shifted;
}

with : ctx_objmode=1 {
# p.183
:cmpr "0" is op0_16=0b0101011000011101 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	TC = AR0 == *[register]:2 rp;
}
# p.183
:cmpr "1" is op0_16=0b0101011000011001 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	TC = AR0 > *[register]:2 rp;
}
# p.183
:cmpr "2" is op0_16=0b0101011000011000 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	TC = AR0 < *[register]:2 rp;
}
# p.183
:cmpr "3" is op0_16=0b0101011000011100 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	TC = AR0 != *[register]:2 rp;
}
}

# p.184
:csb ACC is ctx_objmode=1 & op0_16=0b0101011000110101 & ACC {
	local acc:4 = ACC;
	local count:2;
	if (acc s< 0) goto <neg>;
	count = lzcount(acc);
	goto <done>;
<neg>
	count = lzcount(~acc);
<done>
	T = count - 1;
	flagnz(acc);
	TC = N;
}

# p.185
:dec loc16 is op8_8=0b00001011 & loc16 {
	local r:2 = loc16 - 1;
	loc16 = r;
	flagnz(r);
}

# p.403, p.186 (DINT)
:setc INTM is op0_16=0b0011101100010000 & INTM {
	INTM = 1;
}

# p.187
:dmac ACC:P, loc32, *XAR7 is ctx_objmode=1 & op0_16=0b0101011001001011; op8_8=0b11000111 & ACC & P & loc32 & XAR7 {
	XT = loc32;
	local coeff:4 = *:4 XAR7;
	local prod_hi:4 = sext(XT[16,16]) * sext(coeff[16,16]);
	local prod_lo:4 = sext(XT[0,16]) * sext(coeff[0,16]);
	local sh_hi:4;
	local sh_lo:4;
	pmshift(sh_hi, prod_hi);
	pmshift(sh_lo, prod_lo);
	acc_add32(sh_hi);
	P = P + sh_lo;
}

# p.187
:dmac ACC:P, loc32, *XAR7++ is ctx_objmode=1 & op0_16=0b0101011001001011; op8_8=0b10000111 & ACC & P & loc32 & XAR7 {
	XT = loc32;
	local coeff:4 = *:4 XAR7;
	local prod_hi:4 = sext(XT[16,16]) * sext(coeff[16,16]);
	local prod_lo:4 = sext(XT[0,16]) * sext(coeff[0,16]);
	local sh_hi:4;
	local sh_lo:4;
	pmshift(sh_hi, prod_hi);
	pmshift(sh_lo, prod_lo);
	acc_add32(sh_hi);
	P = P + sh_lo;
	XAR7 = XAR7 + 2;
}

# p.189
:dmov mem16_addr is ctx_objmode=1 & op8_8=0b10100101 & mem16_addr {
	local value:2 = *:2 mem16_addr;
	*:2 (mem16_addr + 1) = value;
}

# p.190
:eallow is op0_16=0b0111011000100010 {
	EALLOW = 1;
}

# p.191
:edis is op0_16=0b0111011000011010 {
	EALLOW = 0;
}

# p.192 (EINT = CLRC INTM)
:clrc INTM is op0_16=0b0010100100010000 & INTM {
	INTM = 0;
}

# p.193
:estop0 is op0_16=0b0111011000100101 {
	breakpoint();
}

# p.194
:estop1 is op0_16=0b0111011000100100 {
	breakpoint();
}

# p.195
:ffc XAR7, imm22 is op6_10=0b0000000011 & XAR7 & $(imm22) {
    XAR7 = inst_next;
    local tgt:4 = imm22;
    call [tgt];
}

# p.196
:flip ax0 is ctx_objmode=1 & op1_15=0b010101100111000 & ax0 {
	bitrev16(ax0);
	flagnz(ax0);
}

# p.197
:iack #imm16 is op0_16=0b0111011000111111; imm16 {
	iack(imm16:2);
}

# p.198
:idle is op0_16=0b0111011000100001 {
	IDLESTAT = 1;
}

# p.199
:imacl P, loc32, *XAR7 is ctx_objmode=1 & op0_16=0b0101011001001101; op8_8=0b11000111 & P & loc32 & XAR7 {
	# TODO C, V, OVCU, OVM
	ACC = ACC + P;
	local tmp:8 = sext(loc32) * sext(*:4 XAR7);
	store_p_lower38(tmp);
	flagnz(ACC);
}

# p.199
:imacl P, loc32, *XAR7++ is ctx_objmode=1 & op0_16=0b0101011001001101; op8_8=0b10000111 & P & loc32 & XAR7 {
	# TODO C, V, OVCU, OVM
	ACC = ACC + P;
	local tmp:8 = sext(loc32) * sext(*:4 XAR7);
	store_p_lower38(tmp);
	XAR7 = XAR7 + 1;
	flagnz(ACC);
}

# p.201
:impyal P, XT, loc32 is ctx_objmode=1 & op0_16=0b0101011001001100; op8_8=0b00000000 & P & XT & loc32 {
	# Snapshot both sources before ACC and P writeback so register-addressed
	# aliases observe the instruction's original state.
	local old_p:4 = P;
	local multiplicand:4 = loc32;
	add_unsigned32(ACC, old_p);
	local prod:8 = sext(XT) * sext(multiplicand);
	store_p_lower38(prod);
}

# p.203
:impyl ACC, XT, loc32 is ctx_objmode=1 & op0_16=0b0101011001000100; op8_8=0b00000000 & ACC & XT & loc32 {
	local prod:8 = sext(XT) * sext(loc32);
	ACC = prod[0,32];
	flagnz(ACC);
}

# p.204
:impyl P, XT, loc32 is ctx_objmode=1 & op0_16=0b0101011000000101; op8_8=0b00000000 & P & XT & loc32 {
	local prod:8 = sext(XT) * sext(loc32);
	store_p_lower38(prod);
}

# p.205
:impysl P, XT, loc32 is ctx_objmode=1 & op0_16=0b0101011001000011; op8_8=0b00000000 & P & XT & loc32 {
	local oldp:4 = P;
	acc_sub32(oldp);
	local prod:8 = sext(XT) * sext(loc32);
	store_p_lower38(prod);
}

# p.207
:impyxul P, XT, loc32 is ctx_objmode=1 & op0_16=0b0101011001100101; op8_8=0b00000000 & P & XT & loc32 {
	local prod:8 = sext(XT) * zext(loc32);
	store_p_lower38(prod);
}

# p.209
:in loc16, *(imm16) is ctx_objmode=1 & op8_8=0b10110100 & loc16; imm16 {
	local ptr:4 = zext(imm16:2);
	loc16 = *:2 ptr;
}

# p.211
:inc loc16 is op8_8=0b00001010 & loc16 {
	local r:2 = loc16 + 1;
	loc16 = r;
	flagnz(r);
}

# p.212
:intr "INT"^intno is op4_12=0b000000000001 & imm4 [ intno = imm4 + 1; ] {
	local tmp4:2 = imm4;
	local imm4v:4 = zext(tmp4) + zext(tmp4);
	local vec:4 = 0x3FFFC2 + imm4v;
	intr_enter(vec);
}
# p.212
:intr "DLOGINT" is op4_12=0b000000000001 & imm4=0b1110 {
	local vec2:4 = 0x3FFFDE;
	intr_enter(vec2);
}
# p.212
:intr "RTOSINT" is op4_12=0b000000000001 & imm4=0b1111 {
	local vec3:4 = 0x3FFFE0;
	intr_enter(vec3);
}
# p.212
:intr "NMI" is op0_16=0b0111011000010110 {
	local vec4:4 = 0x3FFFE4;
	intr_enter(vec4);
}
# p.212
:intr "EMU" is op0_16=0b0111011000011100 {
	intr_emu();
}

# p.214
:iret is op0_16=0b0111011000000010 {
	local ret_pc:4;
	pop32(ret_pc);
	local ier_dbgstat:4;
	pop32(ier_dbgstat);
	IER = ier_dbgstat[0,16];
	local dp_st1:4;
	pop32(dp_st1);
	unpackst1(dp_st1[0,16]);
	DP = dp_st1[16,16];
	local ar1_ar0:4;
	pop32(ar1_ar0);
	AR0 = ar1_ar0[0,16];
	AR1 = ar1_ar0[16,16];
	pop32(P);
	pop32(ACC);
	local t_st0:4;
	pop32(t_st0);
	unpackst0(t_st0[0,16]);
	T = t_st0[16,16];
	RB_RA = RB_RAS;
	RB_RAS = 0;
	# Interrupt entry reserves one alignment word before seven context pairs.
	sp_sub(1);
	return [ret_pc];
}

# p.216
:lb *XAR7 is ffc_return=0 & switch_canonical=1 & op0_16=0b0111011000100000 & XAR7 {
	# The switch analyzer has validated that every loaded table entry is a
	# 22-bit code address.  Keeping the loaded value directly on BRANCHIND lets
	# Ghidra's generic native jump-table model recognize the data dependency.
	goto [XAR7];
}

# p.216
:lb *XAR7 is ffc_return=1 & switch_canonical=0 & op0_16=0b0111011000100000 & XAR7 {
	# FFC writes its fall-through address to XAR7.  The processor analyzer only
	# selects this constructor for a bounded, exclusive FFC destination whose
	# straight-line helper body leaves XAR7 untouched through this terminal LB.
	local target:4 = XAR7 & 0x003fffff;
	return [target];
}

# p.216
:lb *XAR7 is ffc_return=0 & switch_canonical=0 & op0_16=0b0111011000100000 & XAR7 {
	# Only XAR7(21:0) is loaded into the architectural PC.
	local target:4 = XAR7 & 0x003fffff;
	goto [target];
}

# p.217
:lb dest22 is op6_10=0b0000000001 ... & dest22 {
	goto dest22;
}

# p.218
:lc *XAR7 is op0_16=0b0111011000000100 & XAR7 {
	local tmp:4 = inst_next;
	push32(tmp);
	# Like LB *XAR7, LC ignores XAR7(31:22).
	local target:4 = XAR7 & 0x003fffff;
	call [target];
}

# p.219
:lc dest22 is op6_10=0b0000000010 ... & dest22 {
	local tmp:4 = inst_next;
	push32(tmp);
	call dest22;
}

# p.220
:lcr dest22 is ctx_objmode=1 & op6_10=0b0111011001 ... & dest22 {
	local tmp:4 = RPC;
	push32(tmp);
	RPC = inst_next;
	call dest22;
}

# p.221
:lcr *xarn0 is ctx_objmode=1 & op3_13=0b0011111001100 & xarn0 {
	local tmp:4 = RPC;
	push32(tmp);
	RPC = inst_next;
	local target:4 = xarn0 & 0x003fffff;
	call [target];
}

# p.222
:loopnz loc16, #imm16 is op8_8=0b00101110 & loc16; imm16 {
	LOOP = 1;
	local masked:2 = loc16 & imm16:2;
	N = masked[15,1];
	Z = (masked == 0);
	if (Z) goto <done>;
	goto inst_start;
<done>
	LOOP = 0;
}

# p.224
:loopz loc16, #imm16 is op8_8=0b00101100 & loc16; imm16 {
	LOOP = 1;
	local masked:2 = loc16 & imm16:2;
	N = masked[15,1];
	Z = (masked == 0);
	if (!Z) goto <done>;
	goto inst_start;
<done>
	LOOP = 0;
}

# p.226 (LPADDR)
:setc AMODE is op0_16=0b0101011000011110 & AMODE [ ctx_amode=1; globalset(inst_next, ctx_amode); ] {
	AMODE = 1;
}

# p.227
:lret is op0_16=0b0111011000010100 {
	local tmp:4;
	pop32(tmp);
	return [tmp];
}

# p.228
:lrete is op0_16=0b0111011000010000 {
	local tmp:4;
	pop32(tmp);
	INTM = 0;
	return [tmp];
}

# p.229
:lretr is ctx_objmode=1 & op0_16=0b0000000000000110 {
	local tmp = RPC;
	pop32(RPC);
	return [tmp];
}

# p.230
:lsl ACC, shift0_4_1 is op4_12=0b111111110011 & ACC & shift0_4_1 {
	local tmp:4 = ACC << (shift0_4_1 - 1);
	C = tmp[31, 1];
	ACC = tmp << 1;
	flagnz(ACC);
}

# p.231
:lsl ACC, T is op0_16=0b1111111101010000 & ACC & T {
	local shift:4 = zext(T[0,4]);
	if (shift != 0) goto <shifted>;
	C = 0;
	goto <done>;
	<shifted>
	local tmp:4 = ACC << (shift - 1);
	C = tmp[31, 1];
