# p.176
:clrc imm8 is op8_8=0b00101001 & imm8 { # TODO SXM|OVM|TC|C|INTM|DBGM|PAGE0|VMAP
	local bimm8:1 = imm8;
	SXM   = SXM   && (bimm8[0,1] == 0);
	OVM   = OVM   && (bimm8[1,1] == 0);
	TC    = TC    && (bimm8[2,1] == 0);
	C     = C     && (bimm8[3,1] == 0);
	INTM  = INTM  && (bimm8[4,1] == 0);
	DBGM  = DBGM  && (bimm8[5,1] == 0);
	PAGE0 = PAGE0 && (bimm8[6,1] == 0);
	VMAP  = VMAP  && (bimm8[7,1] == 0);
}

# p.177
:cmp ax8, loc16 is op9_7=0b0101010 & ax8 & loc16 {
	local tmp:3 = sext(ax8) - sext(loc16);
	flagnz(tmp);
	C = ax8 >= loc16;
}

# p.178
:cmp loc16, #simm16 is op8_8=0b00011011 & loc16; simm16 {
	local tmp:3 = zext(loc16) - simm16;
	flagnz(tmp);
	# TODO C flag
}

# p.179
:cmp64 ACC:P is objmode=1 & op0_16=0b0101011001011110 & ACC & P {
	N = ACC[31, 1] ^ V;
	local lo:8 = zext(P);
	local hi:8 = zext(ACC);
	Z = ((hi << 32) | lo) == 0;
	V = 0;
}

# p.180
:cmpb ax8, #imm8 is op9_7=0b0101001 & ax8 & imm8 {
	local tmp:3 = zext(ax8) - imm8; # 3 bytes so it behaves like infinite precision in all cases
	flagnz(tmp);
	# TODO C flag
}

# p.181
:cmpl ACC, loc32 is op8_8=0b00001111 & ACC & loc32 {
	local tmp:5 = sext(ACC) - sext(loc32);
	flagnz(tmp);
	C = ACC >= loc32;
}

# p.182
:cmpl ACC, P << PM is op0_16=0b1111111101011001 & ACC & P & PM {
	local shifted:4 = P << PM;
	local tmp:5 = sext(ACC) - sext(shifted);
	flagnz(tmp);
	C = ACC >= shifted;
	# TODO PM negative = arithmetic right shift; pcode INT_LEFT with negative arg is approximate
}

