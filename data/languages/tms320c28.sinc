define token opcode (16)
	op0_16		= (0,15)
	op4_12		= (4,15)
	op4_4		= (4,7)
	op6_2		= (6,7)
	op8_8		= (8,15)
	op9_7		= (9,15)
	ax8			= (8,8)
	op12_4		= (12,15)

	shift0_4	= (0,3)
	shift8_4	= (8,11)
	loc16f		= (0,7)
	reg16		= (0,3)
	imm6		= (0,5)
	imm7		= (0,6)
	imm16		= (0,15)
;

attach variables ax8 [ AL AH ];
# T is also called TH, section 2.2 CPU Registers (p. 23) calls it T but for example the loc16/loc32 addressing mode table (p. 81) uses TH
attach variables reg16 [ AR0 AR1 AR2 AR3 AR4 AR5 AR6 AR7 AH AL PH PL T SP _ _ ];

################################################################
# Macros
################################################################

macro push16(val16) {
	SP = SP - 2;
	*:2 SP = val16;
}

macro pop16(ret16) {
	ret16 = *:2 SP;
	SP = SP + 2;
}

macro push8(val8) {
	SP = SP - 1;
	ptr:2 = SP;
	*:1 ptr = val8;
}

macro pop8(ret8) {
	ptr:2 = SP;
	ret8 = *:1 ptr;
	SP = SP + 1;
}

################################################################
# Addressing and stuff
################################################################

loc16: @imm6 is amode=0 & op6_2=0b00 & imm6 {}
loc16: reg16 is amode=0 & op4_4=0b1010 & reg16 {}

################################################################

# p.124
:aborti is op0_16=0b0000000000000001 {}

# p.125
:abs ACC is op0_16=0b1111111101010110 & ACC {}

# p.126
:abstc ACC is op0_16=0b0101011001011111 & objmode=1 & ACC {}

# p.128
:add ACC, #imm16 << #shift0_4 is op4_12=0b111111110001 & ACC & shift0_4; imm16 {}  # sxm

# p.129
:add ACC, loc16 << T is op0_16=0b0101011000100011 & objmode=1 & ACC & T; op8_8=0 & loc16 {} # TODO loc16!

# p.130
:add ACC, loc16 is op8_8=0b10000001 & objmode=1 & ACC & loc16 {} # TODO loc16!

# p.130
:add ACC, loc16 << #shift8_4 is op0_16=0b0101011000000100; op12_4=0b0000 & objmode=1 & ACC & loc16 & shift8_4 {} # TODO loc16!

# p.130
:add ACC, loc16 << #16 is op8_8=0b00000101 & ACC & loc16 {} # TODO loc16!

# p.130
:add ACC, loc16 << #shift0_4 is op12_4=0b1010 & objmode=0 & ACC & loc16 & shift0_4 {} # TODO loc16!

# p.131
:add ax8, loc16 is op9_7=0b1001010 & ax8 & loc16 {}

# p.132
:add loc16, ax8 is op9_7=0b0111001 & ax8 & loc16 {}