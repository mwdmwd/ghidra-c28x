define token opcode (16)
   op0_16		 = (0,15)
   op0_12		 = (0,11)
   shift4		 = (12,15)
;

define token data16 (16)
   imm16		= (0,15)
   sign16		= (15,15)
   simm16		= (0,15) signed
;

################################################################
# Macros
################################################################

macro push16(val16) {
	SP = SP - 2;
	*:2 SP = val16;
}

macro pop16(ret16) {
	ret16 = *:2 SP;
	SP = SP + 2;
}

macro push8(val8) {
	SP = SP - 1;
	ptr:2 = SP;
	*:1 ptr = val8;
}

macro pop8(ret8) {
	ptr:2 = SP;
	ret8 = *:1 ptr;
	SP = SP + 1;
}

################################################################
# Addressing and stuff
################################################################

# Absolute
#OP1: imm16	  is imm16			{ export *:1 imm16; }

################################################################

:aborti is op0_16=0b0000000000000001 {}

:abs ACC is op0_16=0b1111111101010110 & ACC {}

:abstc ACC is op0_16=0b0101011001011111 & objmode=1 & ACC {}

:add ACC,imm16<<shift4 is op0_12=0b111111110001 & ACC & shift4; imm16 {}  # sxm
