# p.393
:rol ACC is op0_16=0b1111111101010011 & ACC {
	local old_c:1 = C;
	C = ACC[31,1];
	ACC = (ACC << 1) | zext(old_c);
	flagnz(ACC);
}

# p.394
:ror ACC is op0_16=0b1111111101010010 & ACC {
	local old_c:1 = C;
	C = ACC[0,1];
	ACC = (ACC >> 1) | (zext(old_c) << 31);
	flagnz(ACC);
}

# p.395 - loads RPTC with N; next instruction executes N+1 times (see ^instruction above)
:rpt #imm8 is op8_8=0b11110110 & imm8 [ rpt_active=1; globalset(inst_next, rpt_active); ] {
    RPTC = zext(imm8:1);
}
:rpt loc16 is op8_8=0b11110111 & loc16 [ rpt_active=1; globalset(inst_next, rpt_active); ] {
    local cnt:2 = loc16;
    RPTC = cnt;
}

# p.396
:sat ACC is op0_16=0b1111111101010111 & ACC {
	C = 0;
	if (OVC == 0) goto <no_sat>;
	V = 1;
	if (OVC[5,1] != 0) goto <neg_sat>;
	ACC = 0x7fffffff;
	goto <done>;
<neg_sat>
	ACC = 0x80000000;
	goto <done>;
<no_sat>
	V = 0;
<done>
	OVC = 0;
	flagnz(ACC);
}

# p.397
:sat64 ACC:P is ctx_objmode=1 & op0_16=0b0101011000111110 & ACC & P {
	C = 0;
	if (OVC == 0) goto <no_sat>;
	V = 1;
	if (OVC[5,1] != 0) goto <neg_sat>;
	ACC = 0x7fffffff;
	P = 0xffffffff;
	goto <done>;
<neg_sat>
	ACC = 0x80000000;
	P = 0;
	goto <done>;
<no_sat>
	V = 0;
<done>
	OVC = 0;
	N = ACC[31,1];
	Z = ((ACC | P) == 0);
}

