	acc_sub_pm_p();
}

# p.430
:subl loc32, ACC is ctx_objmode=1 & op0_16=0b0101011001000001; op8_8=0b00000000 & loc32 & ACC {
	local r:4 = loc32 - ACC;
	loc32 = r;
	flagnz(r);
}

