# p.394
:ror ACC is op0_16=0b1111111101010010 & ACC {
	local old_c:1 = C;
	C = ACC[0,1];
	ACC = (ACC >> 1) | (zext(old_c) << 31);
	flagnz(ACC);
}

# p.395 - loads RPTC with N; next instruction executes N+1 times (see ^instruction above)
:rpt #imm8 is op8_8=0b11110110 & imm8 [ rpt_active=1; globalset(inst_next, rpt_active); ] {
    RPTC = zext(imm8:1);
}
:rpt loc16 is op8_8=0b11110111 & loc16 [ rpt_active=1; globalset(inst_next, rpt_active); ] {
    local cnt:2 = loc16;
    RPTC = cnt;
}

# p.396
:sat ACC is op0_16=0b1111111101010111 & ACC {}

# p.397
:sat64 ACC:P is objmode=1 & op0_16=0b0101011000111110 & ACC & P {}

# p.399 Need description here
:sb off8, cond8 is op12_4=0b0110 & off8 & cond8 {
	if (cond8) goto off8;
}

# p.400
:sbbu ACC, loc16 is op8_8=0b00011101 & ACC & loc16 {}

# p.401
:sbf off8, "EQ"  is objmode=1 & op8_8=0b11101100 & off8 {
	if (Z == 0) goto off8;
}
:sbf off8, "NEQ" is objmode=1 & op8_8=0b11101101 & off8 {
	if (Z == 1) goto off8;
}
:sbf off8, "TC"  is objmode=1 & op8_8=0b11101110 & off8 {
	if (TC == 0) goto off8;
}
:sbf off8, "NTC" is objmode=1 & op8_8=0b11101111 & off8 {
	if (TC == 1) goto off8;
}

# p.402
:sbrk #imm8 is op8_8=0b11111101 & imm8 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	local rv:4 = *[register]:4 rp;
	*[register]:4 rp = rv - imm8;
}

# p.403
:setc imm8 is op8_8=0b00111011 & imm8 { # TODO SXM|OVM|TC|C|INTM|DBGM|PAGE0|VMAP in dasm
	local bimm8:1 = imm8;
	SXM   = SXM   || (bimm8[0,1] != 0);
	OVM   = OVM   || (bimm8[1,1] != 0);
	TC    = TC    || (bimm8[2,1] != 0);
	C     = C     || (bimm8[3,1] != 0);
	INTM  = INTM  || (bimm8[4,1] != 0);
	DBGM  = DBGM  || (bimm8[5,1] != 0);
	PAGE0 = PAGE0 || (bimm8[6,1] != 0);
	VMAP  = VMAP  || (bimm8[7,1] != 0);
} 

# p.407
:setc "XF" is op0_16=0b0101011000100110 {
	XF = 1;
}

# p.408
:sfr ACC, shift0_4_1 is op4_12=0b111111110100 & ACC & shift0_4_1 {
	if (!SXM) goto <lsr>;
	ACC = ACC s>> shift0_4_1;
	goto <done>;
	<lsr>
	ACC = ACC >> shift0_4_1;
	<done>
	flagnz(ACC);
}

# p.409
:sfr ACC, T is op0_16=0b1111111101010001 & ACC & T {
	if (!SXM) goto <lsr>;
	ACC = ACC s>> T[0,4];
	goto <done>;
	<lsr>
	ACC = ACC >> T[0,4];
	<done>
	flagnz(ACC);
}

# p.410
:spm  #1 is           op0_16=0b1111111101101000 {
	PM = 1;
}
:spm  #0 is           op0_16=0b1111111101101001 {
	PM = 0;
}
:spm #-1 is           op0_16=0b1111111101101010 {
	PM = -1;
}
:spm #-2 is           op0_16=0b1111111101101011 {
	PM = -2;
}
:spm #-3 is           op0_16=0b1111111101101100 {
	PM = -3;
}
:spm #-4 is amode=0 & op0_16=0b1111111101101101 {
	PM = -4;
}
:spm  #4 is amode=1 & op0_16=0b1111111101101101 {
	PM = 4;
}
:spm #-5 is           op0_16=0b1111111101101110 {
	PM = -5;
}
:spm #-6 is           op0_16=0b1111111101101111 {
	PM = -6;
}

# p.412
:sqra loc16 is objmode=1 & op0_16=0b0101011000010101; op8_8=0b00000000 & loc16 {
	ACC = ACC + P << PM;
	#T = loc16; # TODO
	#P = T * T;
}

# p.413
:sqrs loc16 is objmode=1 & op0_16=0b0101011000010001; loc16 {}

# p.414
:sub ACC, loc16 is objmode=1 & op8_8=0b10101110 & ACC & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	ACC = ACC - tmp;
	flagnz(ACC);
}
:sub ACC, loc16 is objmode=0 & op8_8=0b10000000 & ACC & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	ACC = ACC - tmp;
	flagnz(ACC);
}
:sub ACC, loc16 << #shift8_4 is objmode=1 & op0_16=0b0101011000000000; op12_4=0b0000 & ACC & loc16 & shift8_4 {
	local tmp:4;
	mext(tmp, loc16);
	ACC = ACC - (tmp << shift8_4);
	flagnz(ACC);
}
#:sub ACC, loc16 << #shift8_4 is objmode=0 & op12_4=0b1000 & ACC & loc16 & shift8_4 {} # TODO conflict with `POP XT`
:sub ACC, loc16 << #16 is op8_8=0b00000100 & ACC & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	ACC = ACC - (tmp << 16);
	flagnz(ACC);
}

# p.416
:sub ACC, loc16 << T is objmode=1 & op0_16=0b0101011000100111; op8_8=0b00000000 & ACC & loc16 & T {
	local tmp:4;
	mext(tmp, loc16);
	ACC = ACC - (tmp << T[0,4]);
	flagnz(ACC);
}

# p.417
:sub ACC, #imm16 << #shift0_4 is op4_12=0b111111110000 & shift0_4; ACC & imm16 {
	local tmp:4;
	mext(tmp, imm16:2);
	ACC = ACC - (tmp << shift0_4);
	flagnz(ACC);
}

# p.418
:sub ax8, loc16 is op9_7=0b1001111 & ax8 & loc16 {
	ax8 = ax8 - loc16;
	flagnz(ax8);
}

# p.419
:sub loc16, ax8 is op9_7=0b0111010 & ax8 & loc16 {
	local r:2 = loc16 - ax8;
	loc16 = r;
	flagnz(r);
}

# p.420
:subb ACC, #imm8 is op8_8=0b00011001 & ACC & imm8 {
	ACC = ACC - imm8;
}

# p.421
:subb SP, #imm7 is op7_9=0b111111101 & SP & imm7 {
	SP = SP - imm7;
}

# p.422
:subb xarn8, #imm7 is op11_5=0b11011 & op7=0b1 & xarn8 & imm7 {
	xarn8 = xarn8 - imm7;
}

# p.423
:subbl ACC, loc32 is objmode=1 & op0_16=0b0101011001010100; op8_8=0b00000000 & ACC & loc32 {}

# p.424
:subcu ACC, loc16 is op8_8=0b00011111 & ACC & loc16 {}

# p.426
:subcul ACC, loc32 is objmode=1 & op0_16=0b0101011000010111; op8_8=0b00000000 & ACC & loc32 {}

# p.428
:subl ACC, loc32 is objmode=1 & op8_8=0b00000011 & ACC & loc32 {
	ACC = ACC - loc32;
	flagnz(ACC);
}

# p.429
:subl ACC, P << PM is op0_16=0b0001000110101100 & ACC & P & PM {} # conflict with MOVS T, T

# p.430
:subl loc32, ACC is objmode=1 & op0_16=0b0101011001000001; op8_8=0b00000000 & loc32 & ACC {
	local r:4 = loc32 - ACC;
	loc32 = r;
	flagnz(r);
}

# p.431
:subr loc16, ax8 is objmode=1 & op9_7=0b1110101 & ax8 & loc16 {
	local r:2 = ax8 - loc16;
	loc16 = r;
	flagnz(r);
}

# p.432
:subrl loc32, ACC is objmode=1 & op0_16=0b0101011001001001; op8_8=0b00000000 & loc32 & ACC {
	local r:4 = ACC - loc32;
	loc32 = r;
	flagnz(r);
}

# p.433
:subu ACC, loc16 is op8_8=0b00000001 & ACC & loc16 {
	ACC = ACC - zext(loc16);
	flagnz(ACC);
}

# p.434
:subul ACC, loc32 is objmode=1 & op0_16=0b0101011001010101; op8_8=0b00000000 & ACC & loc32 {
	ACC = ACC - loc32;
	flagnz(ACC);
}

# p.435
:subul P, loc32 is op0_16=0b0101011001011101; op8_8=0b00000000 & P & loc32 {}

# p.436
:tbit loc16, #imm8_4 is op12_4=0b0100 & imm8_4 & loc16 {
	local sh:2 = imm8_4;
	local shifted:2 = loc16 >> sh;
	TC = shifted[0,1];
}

# p.437
:tbit loc16, T is objmode=1 & op0_16=0b0101011000100101; op8_8=0b00000000 & loc16 & T {
	local shifted:2 = loc16 >> T[0,4];
	TC = shifted[0,1];
}

# p.438
:tclr loc16, #imm8_4 is objmode=1 & op0_16=0b0101011000001001; op12_4=0b0000 & imm8_4 & loc16 {
	local sh:2 = imm8_4;
	local shifted:2 = loc16 >> sh;
	TC = shifted[0,1];
	loc16 = loc16 & ~(1:2 << sh);
}

# p.439
:test ACC is op0_16=0b1111111101011000 & ACC {
	flagnz(ACC);
}

# p.440
:trap #imm5 is op5_11=0b00000000001 & imm5 {}

# p.442
:tset loc16, #imm8_4 is objmode=1 & op0_16=0b0101011000001101; op12_4=0b0000 & loc16 & imm8_4 {
	local sh:2 = imm8_4;
	local shifted:2 = loc16 >> sh;
	TC = shifted[0,1];
	loc16 = loc16 | (1:2 << sh);
}

# p.443
:uout *(imm16), loc16 is objmode=1 & op8_8=0b10110000 & loc16; imm16 {}

# p.444
:xb *AL is objmode=1 & op0_16=0b0101011000010100 & AL {}

# p.445
:xb imm16, *, "ARP"^imm3 is objmode=1 & op3_13=0b0011111001110 & imm3; imm16 {}

# p.446
:xb imm16, cond is objmode=1 & op4_12=0b010101101101 & cond; imm16 {}

# p.448
:xbanz imm16, *                   is objmode=1 & op0_16=0b0101011000001100; imm16 {}
:xbanz imm16, *++                 is objmode=1 & op0_16=0b0101011000001010; imm16 {}
:xbanz imm16, *--                 is objmode=1 & op0_16=0b0101011000001011; imm16 {}
:xbanz imm16, *0++                is objmode=1 & op0_16=0b0101011000001110; imm16 {}
:xbanz imm16, *0--                is objmode=1 & op0_16=0b0101011000001111; imm16 {}
:xbanz imm16, *"ARP"^imm3         is objmode=1 & op3_13=0b0011111000110 & imm3; imm16 {}
:xbanz imm16, *++,  "ARP"^imm3    is objmode=1 & op3_13=0b0011111000111 & imm3; imm16 {}
:xbanz imm16, *--,  "ARP"^imm3    is objmode=1 & op3_13=0b0011111001000 & imm3; imm16 {}
:xbanz imm16, *0++, "ARP"^imm3    is objmode=1 & op3_13=0b0011111001001 & imm3; imm16 {}
:xbanz imm16, *0--, "ARP"^imm3    is objmode=1 & op3_13=0b0011111001010 & imm3; imm16 {}

# p.450
:xcall *AL is objmode=1 & op0_16=0b0101011000110100 & AL {}

# p.451
:xcall imm16, *, "ARP"^imm3 is objmode=1 & op3_13=0b0011111001101 & imm3; imm16 {}

# p.452
:xcall imm16, cond is objmode=1 & op4_12=0b010101101110 & cond; imm16 {}

# p.454
:xmac P, loc16, *(imm16) is objmode=1 & op8_8=0b10000100 & P & loc16; imm16 {}

# p.456
:xmacd P, loc16, *(imm16) is objmode=1 & op8_8=0b10100100 & P & loc16; imm16 {}

# p.458
:xor ACC, loc16 is objmode=1 & op8_8=0b10110111 & ACC & loc16 {
	ACC = ACC ^ zext(loc16);
	flagnz(ACC);
}

# p.459
:xor ACC, #imm16 << #shift0_4 is objmode=1 & op4_12=0b001111100010 & shift0_4; ACC & imm16 {
	local tmp:4 = zext(imm16:2);
	ACC = ACC ^ (tmp << shift0_4);
	flagnz(ACC);
}
:xor ACC, #imm16 << #16       is objmode=1 & op0_16=0b0101011001001110; ACC & imm16 {
	local tmp:4 = zext(imm16:2);
	ACC = ACC ^ (tmp << 16);
	flagnz(ACC);
}

# p.460
:xor ax8, loc16 is op9_7=0b0111000 & ax8 & loc16 {
	ax8 = ax8 ^ loc16;
	flagnz(ax8);
}

# p.461
:xor loc16, ax8 is op9_7=0b1111001 & ax8 & loc16 {
	local r:2 = loc16 ^ ax8;
	loc16 = r;
	flagnz(r);
}

# p.462
:xor loc16, #imm16 is op8_8=0b00011100 & loc16; imm16 {
	local r:2 = loc16 ^ imm16:2;
	loc16 = r;
	flagnz(r);
}

# p. 463
:xorb ax8, #imm8 is op9_7=0b1111000 & ax8 & imm8 {
	ax8 = ax8 ^ zext(imm8:1);
	flagnz(ax8);
}

# p.464
:xpread loc16, *(imm16) is objmode=1 & op8_8=0b10101100 & loc16; imm16 {}

# p.465
:xpread loc16, *AL is objmode=1 & op0_16=0b0101011000111100; op8_8=0b00000000 & loc16 & AL {}

# p.466
:xpwrite *AL, loc16 is objmode=1 & op0_16=0b0101011000111101; op8_8=0b00000000 & AL & loc16 {}

# p.467
:xret is objmode=1 & op0_16=0b0101011011111111 {
	local tmp:4;
	pop16(tmp);
	tmp = tmp | 0x3f0000;
	return [tmp];
}

# p.468
:xretc cond is objmode=1 & op4_12=0b010101101111 & cond {
	if (!cond) goto inst_next;
	local tmp:4;
	pop16(tmp);
	tmp = tmp | 0x3f0000;
	return [tmp];
}

# p.470
:zalr ACC, loc16 is objmode=1 & op0_16=0b0101011000010011; op8_8=0b00000000 & ACC & loc16 {}

# p.472
:zapa is objmode=1 & op0_16=0b0101011000110011 {}
