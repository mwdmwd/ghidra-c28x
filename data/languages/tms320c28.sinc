	sp_sub(1);
	local addr:4 = SP;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *xarn0++ is ctx_amode=0 & op3_5=0b10000 & xarn0 & imm3 {
	ARP = imm3;
	local addr:4 = xarn0;
	xarn0 = xarn0 + 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *xarn0++ is ctx_amode=1 & ctx_page0=0 & op3_5=0b10000 & xarn0 & imm3 {
	ARP = imm3;
	local addr:4 = xarn0;
	xarn0 = xarn0 + 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *--xarn0 is ctx_amode=0 & op3_5=0b10001 & xarn0 & imm3 {
	ARP = imm3;
	xarn0 = xarn0 - 1;
	local addr:4 = xarn0;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *--xarn0 is ctx_amode=1 & ctx_page0=0 & op3_5=0b10001 & xarn0 & imm3 {
	ARP = imm3;
	xarn0 = xarn0 - 1;
	local addr:4 = xarn0;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}

# C2xLP modes whose MOVB result is defined: no offset, +/- one word, and ARP
# selection.  The MOVB instruction pages explicitly leave AMODE=0 circular,
# *0, BR0, and the AMODE=1 *0...,ARPn/*BR0...,ARPn variants undefined; those
# forms remain outside loc8 rather than receiving guessed byte semantics.
loc8: * is ctx_amode=0 & op0_8=0b10111000 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: * is ctx_amode=1 & ctx_page0=0 & op0_8=0b10111000 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *++ is ctx_amode=0 & op0_8=0b10111001 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr + 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *++ is ctx_amode=1 & ctx_page0=0 & op0_8=0b10111001 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr + 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *-- is ctx_amode=0 & op0_8=0b10111010 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr - 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *-- is ctx_amode=1 & ctx_page0=0 & op0_8=0b10111010 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr - 1;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *"ARP"^imm3 is ctx_amode=0 & op3_5=0b10110 & imm3 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	ARP = imm3;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *"ARP"^imm3 is ctx_amode=1 & ctx_page0=0 & op3_5=0b10110 & imm3 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	ARP = imm3;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *"++,ARP"^imm3 is ctx_amode=1 & ctx_page0=0 & op3_5=0b11000 & imm3 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr + 1;
	ARP = imm3;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
loc8: *"--,ARP"^imm3 is ctx_amode=1 & ctx_page0=0 & op3_5=0b11001 & imm3 {
	local rp:4 = &XAR0 + zext(ARP * 4);
	local addr:4 = *[register]rp;
	*[register]rp = addr - 1;
	ARP = imm3;
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}
# AMODE=1 circular addressing is not in the MOVB undefined-result list.  It
# accesses the low byte of the selected word and advances XAR1 by one word.
loc8: "*+XAR6[AR1%++]" is ctx_amode=1 & ctx_page0=0 & op0_8=0b10111111 {
	local addr:4;
	circular_amode1_address(addr, 1);
	local word:2 = *:2 addr;
	local byte:1 = word:1;
	export byte;
}

# Register modes always address the low byte.
loc8: reg16loc is ctx_amode=0 & op4_4=0b1010 & reg16loc {
	local byte:1 = reg16loc:1;
	export byte;
}
loc8: reg16loc is ctx_amode=1 & ctx_page0=0 & op4_4=0b1010 & reg16loc {
	local byte:1 = reg16loc:1;
	export byte;
}

cond:  "NEQ"  is cond0_4=0b0000 { local cnd:1 = Z   == 0; export cnd; }
cond:  "EQ"   is cond0_4=0b0001 { local cnd:1 = Z   == 1; export cnd; }
cond:  "GT"   is cond0_4=0b0010 { local cnd:1 = Z   == 0 && N == 0; export cnd; }
cond:  "GEQ"  is cond0_4=0b0011 { local cnd:1 = N   == 0; export cnd; }
cond:  "LT"   is cond0_4=0b0100 { local cnd:1 = N   == 1; export cnd; }
cond:  "LEQ"  is cond0_4=0b0101 { local cnd:1 = Z   == 1 || N == 1; export cnd; }
cond:  "HI"   is cond0_4=0b0110 { local cnd:1 = C   == 1 && Z == 0; export cnd; }
cond:  "HIS"  is cond0_4=0b0111 { local cnd:1 = C   == 1; export cnd; }
cond:  "LO"   is cond0_4=0b1000 { local cnd:1 = C   == 0; export cnd; }
cond:  "LOS"  is cond0_4=0b1001 { local cnd:1 = C   == 0 || Z == 1; export cnd; }
cond:  "NOV"  is cond0_4=0b1010 { local cnd:1 = V   == 0; V = 0; export cnd; }
cond:  "OV"   is cond0_4=0b1011 { local cnd:1 = V   == 1; V = 0; export cnd; }
cond:  "NTC"  is cond0_4=0b1100 { local cnd:1 = TC  == 0; export cnd; }
cond:  "TC"   is cond0_4=0b1101 { local cnd:1 = TC  == 1; export cnd; }
cond:  "NBIO" is cond0_4=0b1110 { local cnd:1 = BIO == 0; export cnd; }
cond:  "UNC"  is cond0_4=0b1111 { local cnd:1 = 1; export cnd; }

cond8: "NEQ"  is cond8_4=0b0000 { local cnd:1 = Z   == 0; export cnd; }
cond8: "EQ"   is cond8_4=0b0001 { local cnd:1 = Z   == 1; export cnd; }
cond8: "GT"   is cond8_4=0b0010 { local cnd:1 = Z   == 0 && N == 0; export cnd; }
cond8: "GEQ"  is cond8_4=0b0011 { local cnd:1 = N   == 0; export cnd; }
cond8: "LT"   is cond8_4=0b0100 { local cnd:1 = N   == 1; export cnd; }
cond8: "LEQ"  is cond8_4=0b0101 { local cnd:1 = Z   == 1 || N == 1; export cnd; }
cond8: "HI"   is cond8_4=0b0110 { local cnd:1 = C   == 1 && Z == 0; export cnd; }
cond8: "HIS"  is cond8_4=0b0111 { local cnd:1 = C   == 1; export cnd; }
cond8: "LO"   is cond8_4=0b1000 { local cnd:1 = C   == 0; export cnd; }
cond8: "LOS"  is cond8_4=0b1001 { local cnd:1 = C   == 0 || Z == 1; export cnd; }
cond8: "NOV"  is cond8_4=0b1010 { local cnd:1 = V   == 0; V = 0; export cnd; }
cond8: "OV"   is cond8_4=0b1011 { local cnd:1 = V   == 1; V = 0; export cnd; }
cond8: "NTC"  is cond8_4=0b1100 { local cnd:1 = TC  == 0; export cnd; }
cond8: "TC"   is cond8_4=0b1101 { local cnd:1 = TC  == 1; export cnd; }
cond8: "NBIO" is cond8_4=0b1110 { local cnd:1 = BIO == 0; export cnd; }
cond8: "UNC"  is cond8_4=0b1111 { local cnd:1 = 1; export cnd; }

################################################################
# SPRU430F - August 2001 - Revised April 2015

# Repeated program-space transfers use an instruction-local hardware shadow for
# their program pointer.  The ordinary RPT wrapper below cannot express that by
# rebuilding the instruction at inst_start: each rebuild would snapshot XAR7,
# AL, or the immediate address again.  These exact special cases instead keep
# the shadow in a SLEIGH unique varnode and loop over the addressing operand's
# P-Code explicitly.  Thus loc16 pre/post updates still execute once per
# transfer, while the architectural program pointer remains independent.

# SPRU430F p.368: repeated PREAD shadows *XAR7 and postincrements the shadow.
:pread loc16, *XAR7 is rpt_phase=0 & rpt_active=1 & op8_8=0b00100100 & loc16 & XAR7 {
    local program_shadow:4 = XAR7;
<repeat_pread>
    build loc16;
    local value:2 = *:2 program_shadow;
    loc16 = value;
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_pread>;
    RPTC = RPTC - 1;
    goto <repeat_pread>;
<done_pread>
}
:pread regax, *XAR7 is rpt_phase=0 & rpt_active=1 & op8_8=0b00100100 & regax & regax=8 & op4_4=0b1010 & XAR7 {
    local program_shadow:4 = XAR7;
<repeat_pread_ah>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_pread_ah>;
    RPTC = RPTC - 1;
    goto <repeat_pread_ah>;
<done_pread_ah>
}
:pread regax, *XAR7 is rpt_phase=0 & rpt_active=1 & op8_8=0b00100100 & regax & regax=9 & op4_4=0b1010 & XAR7 {
    local program_shadow:4 = XAR7;
<repeat_pread_al>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_pread_al>;
    RPTC = RPTC - 1;
    goto <repeat_pread_al>;
<done_pread_al>
}

# SPRU430F p.384: repeated PWRITE shadows its *XAR7 destination.
:pwrite *XAR7, loc16 is rpt_phase=0 & rpt_active=1 & op8_8=0b00100110 & loc16 & XAR7 {
    local program_shadow:4 = XAR7;
<repeat_pwrite>
    build loc16;
    local value:2 = loc16;
    *:2 program_shadow = value;
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_pwrite>;
    RPTC = RPTC - 1;
    goto <repeat_pwrite>;
<done_pwrite>
}

# SPRU430F pp.464-466: XPREAD/XPWRITE use the same rule for the
# high-program-page immediate or AL pointer, with AL itself left unchanged by
# the program-side progression.  The @AX forms also refresh N and Z after
# every transfer, as the instruction pages require.
:xpread regax, *(imm16) is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op8_8=0b10101100 & regax & regax=8 & op4_4=0b1010; imm16 {
    local program_shadow:4 = 0x3f0000 | imm16;
<repeat_xpread_imm_ah>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_imm_ah>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_imm_ah>;
<done_xpread_imm_ah>
}
:xpread regax, *(imm16) is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op8_8=0b10101100 & regax & regax=9 & op4_4=0b1010; imm16 {
    local program_shadow:4 = 0x3f0000 | imm16;
<repeat_xpread_imm_al>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_imm_al>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_imm_al>;
<done_xpread_imm_al>
}
:xpread loc16, *(imm16) is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op8_8=0b10101100 & loc16; imm16 {
    local program_shadow:4 = 0x3f0000 | imm16;
<repeat_xpread_imm>
    build loc16;
    local value:2 = *:2 program_shadow;
    loc16 = value;
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_imm>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_imm>;
<done_xpread_imm>
}
:xpread regax, *AL is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op0_16=0b0101011000111100; op8_8=0b00000000 & regax & regax=8 & op4_4=0b1010 & AL {
    local program_shadow:4 = 0x3f0000 | zext(AL);
<repeat_xpread_al_ah>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_al_ah>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_al_ah>;
<done_xpread_al_ah>
}
:xpread regax, *AL is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op0_16=0b0101011000111100; op8_8=0b00000000 & regax & regax=9 & op4_4=0b1010 & AL {
    local program_shadow:4 = 0x3f0000 | zext(AL);
<repeat_xpread_al_al>
    local value:2 = *:2 program_shadow;
    regax = value;
    flagnz(regax);
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_al_al>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_al_al>;
<done_xpread_al_al>
}
:xpread loc16, *AL is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op0_16=0b0101011000111100; op8_8=0b00000000 & loc16 & AL {
    local program_shadow:4 = 0x3f0000 | zext(AL);
<repeat_xpread_al>
    build loc16;
    local value:2 = *:2 program_shadow;
    loc16 = value;
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpread_al>;
    RPTC = RPTC - 1;
    goto <repeat_xpread_al>;
<done_xpread_al>
}
:xpwrite *AL, loc16 is rpt_phase=0 & rpt_active=1 & ctx_objmode=1 & op0_16=0b0101011000111101; op8_8=0b00000000 & AL & loc16 {
    local program_shadow:4 = 0x3f0000 | zext(AL);
<repeat_xpwrite_al>
    build loc16;
    local value:2 = loc16;
    *:2 program_shadow = value;
    program_shadow = program_shadow + 1;
    if (RPTC == 0) goto <done_xpwrite_al>;
    RPTC = RPTC - 1;
    goto <repeat_xpwrite_al>;
<done_xpwrite_al>
}

# RPT repeat wrapper: when an instruction follows RPT, execute it N+1 times.
# rpt_active is set (with noflow) by RPT on inst_next; rpt_phase prevents recursion.
# A separately proved full-width SUBCUL division has already summarized all
# 32 executions, so it only needs the architecturally final repeat-counter state.
:^instruction is rpt_phase=0 & rpt_active=1 & subcul_div32=1 & instruction [ rpt_phase=1; ] {
    build instruction;
    RPTC = 0;
}
:^instruction is rpt_phase=0 & rpt_active=1 & subcul_div32=0 & instruction [ rpt_phase=1; ] {
    build instruction;
    if (RPTC == 0) goto inst_next;
    RPTC = RPTC - 1;
    goto inst_start;
}

# RPTB block-end wrapper: loops the whole block RB_RC+1 times total.
# rptb_flag is set (with noflow) by RPTB via globalset on the last block instruction.
# RB_RSTART holds the byte address of the first block instruction (set by RPTB body).
:^instruction is rpt_phase=0 & rptb_flag=1 & instruction [ rpt_phase=1; ] {
    build instruction;
    if (RB_RC == 0) goto <done>;
    RB_RC = RB_RC - 1;
    goto [RB_RSTART];
<done>
    RB_RA = 0;
}


# p.124
:aborti is op0_16=0b0000000000000001 {
	DBGM = 1;
}

# p.125
:abs ACC is op0_16=0b1111111101010110 & ACC {
	local start_acc:4 = ACC;
	local negative:1 = start_acc s< 0;
	local minimum:1 = start_acc == 0x80000000;
	local negative_mask:4 = 0 - zext(negative);
	local absolute:4 = (start_acc & ~negative_mask) | ((-start_acc) & negative_mask);
	local saturate:1 = minimum && (OVM != 0);
	local saturate_mask:4 = 0 - zext(saturate);
	ACC = (absolute & ~saturate_mask) | (0x7fffffff & saturate_mask);
	C = 0;
	V = V || minimum;
	flagnz(ACC);
}

# p.126
:abstc ACC is ctx_objmode=1 & op0_16=0b0101011001011111 & ACC {
	local start_acc:4 = ACC;
	local negative:1 = start_acc s< 0;
	local minimum:1 = start_acc == 0x80000000;
	local negative_mask:4 = 0 - zext(negative);
	local absolute:4 = (start_acc & ~negative_mask) | ((-start_acc) & negative_mask);
	local saturate:1 = minimum && (OVM != 0);
	local saturate_mask:4 = 0 - zext(saturate);
	ACC = (absolute & ~saturate_mask) | (0x7fffffff & saturate_mask);
	C = 0;
	TC = TC ^ negative;
	V = V || minimum;
	flagnz(ACC);
}

# p.128
:add ACC, #imm16 << #shift0_4 is op4_12=0b111111110001 & ACC & shift0_4; imm16 {
	local tmp:4;
	mext(tmp, imm16:2);
	local value:4 = tmp << shift0_4;
	acc_add32(value);
}

# p.129
:add ACC, loc16 << T is ctx_objmode=1 & op0_16=0b0101011000100011 & ACC & T; op8_8=0 & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	local value:4 = tmp << T[0,4];
	acc_add32(value);
}

# p.130
:add ACC, loc16 is ctx_objmode=1 & op8_8=0b10000001 & ACC & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	acc_add32(tmp);
}

# p.130
# A processor analyzer selects this variant only for the exact AR6-indexed,
# zero-based switch schedule.  MOVZ plus the unsigned guard proves AR6 <= the
# validated table bound, and SETC SXM makes the architectural extension
# explicit.  The loaded table base and bounded two-word index cannot carry or
# overflow, and the intervening flags are dead before the computed branch.
# Keeping the proven address expression simple lets stock switch analysis
# recover the table; ordinary ADD sites retain full SXM/OVM-sensitive P-Code.
:add ACC, loc16 << #shift8_4 is switch_canonical=1 & ctx_objmode=1 & op0_16=0b0101011000000100; op12_4=0b0000 & ACC & loc16 & shift8_4 {
	local value:4 = zext(loc16) << shift8_4;
	ACC = ACC + value;
	C = 0;
	flagnz(ACC);
}

# p.130
:add ACC, loc16 << #shift8_4 is switch_canonical=0 & ctx_objmode=1 & op0_16=0b0101011000000100; op12_4=0b0000 & ACC & loc16 & shift8_4 {
	local tmp:4;
	mext(tmp, loc16);
	local value:4 = tmp << shift8_4;
	acc_add32(value);
}

# p.130
:add ACC, loc16 << #16 is op8_8=0b00000101 & ACC & loc16 {
	local tmp:4;
	mext(tmp, loc16);
	local value:4 = tmp << 16;
	acc_add32(value);
}

# p.130
:add ACC, loc16 << #shift0_4 is op12_4=0b1010 & ctx_objmode=0 & ACC & loc16 & shift0_4 {
	local tmp:4;
	mext(tmp, loc16);
	local value:4 = tmp << shift0_4;
	acc_add32(value);
}

# p.131
:add ax8, loc16 is op9_7=0b1001010 & ax8 & loc16 {
	ax8 = ax8 + loc16;
	flagnz(ax8);
}

# p.132
:add loc16, ax8 is op9_7=0b0111001 & ax8 & loc16 {
	local r:2 = loc16 + ax8;
	loc16 = r;
	flagnz(r);
}

# p.133
# The encoded SP operand is 16-bit, but normal TI frames stay within low 64K.
# Keep the analysis carrier as one ordinary pointer-width delta so large frames
# remain recognizable to the stack model; SP16 continues to expose the
# architectural low-word alias to encoded register operations.
:add SP, #simm16 is op8_8=0b00001000 & op4_4=0b1010 & reg16=13 & SP; simm16 {
	local delta:4 = sext(simm16:2);
	sp_add(delta);
	local r:2 = SP16;
	flagnz(r);
}

:add loc16, #simm16 is op8_8=0b00001000 & loc16; simm16 {
	local r:2 = loc16 + simm16:2;
	loc16 = r;
	flagnz(r);
}

# p.134
:addb ACC, #imm8 is op8_8=0b00001001 & ACC & imm8 {
	local value:4 = zext(imm8:1);
	acc_add32(value);
}

# p.135
:addb ax8, #simm8 is op9_7=0b1001110 & ax8 & simm8 {
	ax8 = ax8 + simm8;
	flagnz(ax8);
	# TODO C  V
}

# p.136
:addb SP, #imm7 is op7_9=0b111111100 & SP & imm7 {
	sp_add(imm7);
}

# p.137
:addb xarn8, #imm7 is op11_5=0b11011 & xarn8 & op7=0 & imm7 {
	xarn8 = xarn8 + imm7;
}

# p.138; SPRU430F ADDCL flags and modes.
:addcl ACC, loc32 is ctx_objmode=1 & op0_16=0b0101011001000000 & ACC; loc32 {
	local value:4 = loc32;
	acc_add_carry32(value);
}

# p.139; SPRU430F ADDCU flags and modes.
:addcu ACC, loc16 is op8_8=0b00001100 & ACC & loc16 {
	local value:4 = zext(loc16);
	acc_add_carry32(value);
}

# p.140
:addl ACC, loc32 is op8_8=0b00000111 & ACC & loc32 {
	local value:4 = loc32;
	acc_add32(value);
}

# p.141
:addl ACC, P << PM is op0_16=0b0001000010101100 & ACC & P & PM { # conflict with `mova T, loc16` and `movp T, loc16`
	acc_add_pm_p();
}

# p.142
:addl loc32, ACC is ctx_objmode=1 & op0_16=0b0101011000000001 & ACC; op8_8=0b00000000 & loc32 {
	local r:4 = loc32 + ACC;
	loc32 = r;
	flagnz(r);
}

# p.143
# A finite processor analyzer selects this equivalent form only where OVM=0
# follows from a proved TI C boundary or an explicit CLRC OVM definition.
:addu ACC, loc16 is ovm_zero=1 & op8_8=0b00001101 & ACC & loc16 {
	local value:4 = zext(loc16);
	acc_add32_ovm0(value);
}

# p.143
:addu ACC, loc16 is ovm_zero=0 & op8_8=0b00001101 & ACC & loc16 {
	local value:4 = zext(loc16);
	acc_add32(value);
}

# p.144; SPRU430F ADDUL P uses unsigned carry-counting OVCU.
:addul P, loc32 is ctx_objmode=1 & op0_16=0b0101011001010111 & P; op8_8=0b00000000 & loc32 {
	local value:4 = loc32;
	add_unsigned32(P, value);
}

# p.145; SPRU430F ADDUL ACC uses unsigned carry-counting OVCU.
:addul ACC, loc32 is ctx_objmode=1 & op0_16=0b0101011001010011 & ACC; loc32 {
	local value:4 = loc32;
	add_unsigned32(ACC, value);
}

# p.146
:adrk #imm8 is op8_8=0b11111100 & imm8 {
	local rp:4 = &XAR0 + zext(ARP) * 4;
	local rv:4 = *[register]:4 rp;
	*[register]:4 rp = rv + imm8;
}

# p.147
:and ACC, #imm16 << #shift0_4 is ctx_objmode=1 & op4_12=0b001111100000 & ACC & shift0_4; imm16 {
	local tmp:4 = zext(imm16:2);
	ACC = ACC & (tmp << shift0_4);
	flagnz(ACC);
}

# p.147
:and ACC, #imm16 << #16 is ctx_objmode=1 & op0_16=0b0101011000001000 & ACC; imm16 {
	local tmp:4 = zext(imm16:2);
	ACC = ACC & (tmp << 16);
	flagnz(ACC);
}

# p.148
:and ACC, loc16 is ctx_objmode=1 & op8_8=0b10001001 & ACC & loc16 {
	ACC = ACC & zext(loc16);
	flagnz(ACC);
}

# p.149
:and ax8, loc16, #imm16 is op9_7=0b1100110 & ax8 & loc16; imm16 {
	ax8 = loc16 & imm16:2;
	flagnz(ax8);
}

# p.150
:and IER, #imm16 is op0_16=0b0111011000100110 & IER; imm16 {
	IER = IER & imm16:2;
}

# p.151
:and IFR, #imm16 is op0_16=0b0111011000101111 & IFR; imm16 {
	IFR = IFR & imm16:2;
}

# p.152
:and loc16, ax8 is op9_7=0b1100000 & ax8 & loc16 {
	local r:2 = loc16 & ax8;
	loc16 = r;
	flagnz(r);
}

# p.153
:and ax8, loc16 is op9_7=0b1100111 & ax8 & loc16 {
	ax8 = ax8 & loc16;
	flagnz(ax8);
}

# p.154
:and loc16, #imm16 is op8_8=0b00011000 & loc16; imm16 {
	local r:2 = loc16 & imm16:2;
	loc16 = r;
	flagnz(r);
}

# p.155
:andb ax8, #imm8 is op9_7=0b1001000 & ax8 & imm8 {
	ax8 = ax8 & zext(imm8:1);
	flagnz(ax8);
}

# p.156
:asp is op0_16=0b0111011000011011 {
	SPA = 0;
	if ((SP % 2) == 0) goto inst_next;
	sp_add(1);
	SPA = 1;
}

# p.157
:asr ax4, shift0_4_1 is op5_11=0b11111111101 & ax4 & shift0_4_1 {
	ax4 = ax4 s>> shift0_4_1;
	flagnz(ax4);
}

# p.158
:asr ax0, T is op1_15=0b111111110110010 & ax0 & T {
	ax0 = ax0 s>> T[0,4];
	flagnz(ax0);
}

# p.159
:asr64 ACC:P, shift0_4_1 is ctx_objmode=1 & op4_12=0b010101101000 & ACC & P & shift0_4_1 {
	local lo:8 = zext(P);
	local hi:8 = zext(ACC);
	local val:8 = (hi << 32) | lo;
	local tmp:8 = val s>> (shift0_4_1 - 1);
	C = tmp[0, 1];
	val = tmp s>> 1;
	ACC = val[32, 32];
	P = val[0, 32];
	N = val[63, 1];
	Z = val == 0;
}

# p.160
:asr64 ACC:P, T is ctx_objmode=1 & op0_16=0b0101011000101100 & ACC & P & T {
	local shift:4 = zext(T[0,6]);
	local lo:8 = zext(P);
	local hi:8 = zext(ACC);
	local val:8 = (hi << 32) | lo;
	if (shift != 0) goto <shifted>;
	C = 0;
	goto <done>;
	<shifted>
	local tmp:8 = val s>> (shift - 1);
	C = tmp[0, 1];
	val = tmp s>> 1;
	<done>
	ACC = val[32, 32];
	P = val[0, 32];
	N = val[63, 1];
	Z = val == 0;
}

# p.161
:asrl ACC, T is ctx_objmode=1 & op0_16=0b0101011000010000 & ACC & T {
	local shift:4 = zext(T[0,5]);
	if (shift != 0) goto <shifted>;
	C = 0;
	goto <done>;
	<shifted>
	local tmp:4 = ACC s>> (shift - 1);
	C = tmp[0, 1];
	ACC = tmp s>> 1;
	<done>
	flagnz(ACC);
}

# p.162
:b off16, "UNC" is op4_12=0b111111111110 & cond0_4=0b1111; off16 {
	goto off16;
}

:b off16, cond is op4_12=0b111111111110 & cond; off16 {
	if (cond) goto off16;
}

# p.163
:banz off16, arn0-- is op3_13=0b0000000000001 & arn0; off16 {
	local take:1 = (arn0 != 0);
	arn0 = arn0 - 1;
	if (take) goto off16;
}

# p.164
:bar off16, arn3, arn0, "EQ" is ctx_objmode=1 & op6_10=0b1000111110 & arn3 & arn0; off16 {
	if (arn3 == arn0) goto off16;
}

# p.164
:bar off16, arn3, arn0, "NEQ" is ctx_objmode=1 & op6_10=0b1000111111 & arn3 & arn0; off16 {
	if (arn3 != arn0) goto off16;
}

# p.165
:bf off16, "UNC" is ctx_objmode=1 & op4_12=0b010101101100 & cond0_4=0b1111; off16 {
	goto off16;
}

:bf off16, cond is ctx_objmode=1 & op4_12=0b010101101100 & cond; off16 {
	if (cond) goto off16;
}

