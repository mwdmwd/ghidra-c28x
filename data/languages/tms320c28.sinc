# 8-bit subset of the loc16 addressing modes used by MOVB loads.
#
# Indexed MOVB operands use byte offsets even though the C28x data space is
# word addressed.  byte_index_info exports the word address in bits 31:0 and
# the selected byte (0 = LSB, 1 = MSB) in bit 32 so loads and stores share the
# same effective-address calculation.
byte_index_info: *+xarn0[AR0] is ctx_amode=0 & op3_5=0b10010 & xarn0 & AR0 & imm3 {
	ARP = imm3;
	local offset:2 = AR0;
	local addr:4;
	byte_word_address(addr, xarn0, offset);
	local high:1 = offset:1 & 1;
	local info:5 = zext(addr) | (zext(high) << 32);
	export info;
}
