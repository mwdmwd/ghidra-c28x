# p.403
:setc imm8 is op8_8=0b00111011 & page0_bit=0 & imm8 {
	local bimm8:1 = imm8;
	SXM   = SXM   || (bimm8[0,1] != 0);
	OVM   = OVM   || (bimm8[1,1] != 0);
	TC    = TC    || (bimm8[2,1] != 0);
	C     = C     || (bimm8[3,1] != 0);
	INTM  = INTM  || (bimm8[4,1] != 0);
	DBGM  = DBGM  || (bimm8[5,1] != 0);
	PAGE0 = PAGE0 || (bimm8[6,1] != 0);
	VMAP  = VMAP  || (bimm8[7,1] != 0);
}
:setc imm8 is op8_8=0b00111011 & page0_bit=1 & imm8 [ ctx_page0=1; globalset(inst_next, ctx_page0); ] {
	local bimm8:1 = imm8;
	SXM   = SXM   || (bimm8[0,1] != 0);
	OVM   = OVM   || (bimm8[1,1] != 0);
	TC    = TC    || (bimm8[2,1] != 0);
	C     = C     || (bimm8[3,1] != 0);
	INTM  = INTM  || (bimm8[4,1] != 0);
	DBGM  = DBGM  || (bimm8[5,1] != 0);
	PAGE0 = PAGE0 || (bimm8[6,1] != 0);
	VMAP  = VMAP  || (bimm8[7,1] != 0);
} 

