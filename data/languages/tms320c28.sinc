# p.408
:sfr ACC, shift0_4_1 is op4_12=0b111111110100 & ACC & shift0_4_1 {
	local start_acc:4 = ACC;
	local arithmetic:4 = start_acc s>> shift0_4_1;
	local logical:4 = start_acc >> shift0_4_1;
	local sxm_mask:4 = 0 - zext(SXM);
	local carry_value:4 = start_acc >> (shift0_4_1 - 1);
	ACC = (arithmetic & sxm_mask) | (logical & ~sxm_mask);
	C = carry_value[0,1];
	flagnz(ACC);
}

# p.409
:sfr ACC, T is op0_16=0b1111111101010001 & ACC & T {
	local shift:4 = zext(T[0,4]);
	local nonzero:1 = shift != 0;
	local safe_shift:4 = shift | zext(shift == 0);
	local start_acc:4 = ACC;
	local arithmetic:4 = start_acc s>> shift;
	local logical:4 = start_acc >> shift;
	local sxm_mask:4 = 0 - zext(SXM);
	local carry_value:4 = start_acc >> (safe_shift - 1);
	ACC = (arithmetic & sxm_mask) | (logical & ~sxm_mask);
	C = carry_value[0,1] && nonzero;
	flagnz(ACC);
}

