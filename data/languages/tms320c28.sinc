# p.417
# The switch analyzer selects this form only for a matched 32-bit range guard
# or its dispatch adjustment.  Bit 15 of the immediate is clear, so SXM cannot
# change the operand.  The guard's CMPL overwrites C/N/Z; on its taken path, and
# at the corresponding dispatch, the validated bounds prove no borrow, signed
# overflow, OVC update, or OVM saturation.  Keeping that proven path simple lets
# stock switch analysis recover the native table.  Ordinary SUB sites retain
# the complete SXM/OVM-sensitive semantics below.
:sub ACC, #imm16 << #shift0_4 is switch_canonical=1 & op4_12=0b111111110000 & shift0_4; ACC & imm16 {
	local value:4 = zext(imm16:2) << shift0_4;
	ACC = ACC - value;
	C = 1;
	flagnz(ACC);
}

# p.417
:sub ACC, #imm16 << #shift0_4 is switch_canonical=0 & op4_12=0b111111110000 & shift0_4; ACC & imm16 {
	local tmp:4;
	mext(tmp, imm16:2);
	local value:4 = tmp << shift0_4;
	acc_sub32(value);
}

# p.418
:sub ax8, loc16 is op9_7=0b1001111 & ax8 & loc16 {
	ax8 = ax8 - loc16;
	flagnz(ax8);
}

# p.419
:sub loc16, ax8 is op9_7=0b0111010 & ax8 & loc16 {
	local r:2 = loc16 - ax8;
	loc16 = r;
	flagnz(r);
}

# p.420
# The switch analyzer selects this form only for both SUBB instructions in the
# exact saved-selector schedule whose finite unsigned guard proves that the
# dispatch path cannot borrow, overflow, update OVC, or invoke OVM saturation.
# Ordinary SUBB sites retain the complete architectural accumulator arithmetic
# below.
:subb ACC, #imm8 is switch_canonical=1 & op8_8=0b00011001 & ACC & imm8 {
	local value:4 = zext(imm8:1);
	ACC = ACC - value;
	C = 1;
	flagnz(ACC);
}

# p.420
:subb ACC, #imm8 is switch_canonical=0 & op8_8=0b00011001 & ACC & imm8 {
	local value:4 = zext(imm8:1);
	acc_sub32(value);
}

# p.421
:subb SP, #imm7 is op7_9=0b111111101 & SP & imm7 {
	sp_sub(imm7);
}

# p.422
:subb xarn8, #imm7 is op11_5=0b11011 & op7=0b1 & xarn8 & imm7 {
	xarn8 = xarn8 - imm7;
}

# p.423; SPRU430F SUBBL flags and modes.
:subbl ACC, loc32 is ctx_objmode=1 & op0_16=0b0101011001010100; op8_8=0b00000000 & ACC & loc32 {
	local value:4 = loc32;
	acc_sub_borrow32(value);
}

# p.424 and Appendix E.3.3.  The instruction page prints `temp > 0`,
# while the migration appendix specifies the unsigned 33-bit no-borrow test
# (`temp >= 0`) required by the documented quotient/remainder algorithm.  Split
# the exact 33-bit comparison into the 32-bit shift carry and low-word compare;
# the mask-based commit keeps the constructor branch-free and avoids uint5.
:subcu ACC, loc16 is op8_8=0b00011111 & ACC & loc16 {
	local old:4 = ACC;
	local divisor:2 = loc16;
	local shifted:4 = old << 1;
	local subtrahend:4 = zext(divisor) << 16;
	local shift_carry:1 = carry(old, old);
	local low_no_borrow:1 = (shifted >= subtrahend);
	local no_borrow:1 = shift_carry | low_no_borrow;
	local selected:4 = (shifted - subtrahend) + 1;
	local mask:4 = 0 - zext(no_borrow);
	C = no_borrow;
	ACC = (selected & mask) | (shifted & ~mask);
	flagnz(ACC);
}

# p.426.  The exact 33-bit dividend fragment is {ACC(31:0), P(31)}.
# ACC's shift carry makes the subtraction unconditionally no-borrow; otherwise
# an unsigned low-word compare decides it.  The quotient bit is the same
# no-borrow predicate, so no intra-instruction branch or nonstandard width is
# required.
:subcul ACC, loc32 is subcul_div32=0 & ctx_objmode=1 & op0_16=0b0101011000010111; op8_8=0b00000000 & ACC & loc32 {
	local old_acc:4 = ACC;
	local old_p:4 = P;
	local divisor:4 = loc32;
	local shifted:4 = (old_acc << 1) | zext(old_p[31,1]);
	local shift_carry:1 = carry(old_acc, old_acc);
	local low_no_borrow:1 = (shifted >= divisor);
	local no_borrow:1 = shift_carry | low_no_borrow;
	local difference:4 = shifted - divisor;
	local mask:4 = 0 - zext(no_borrow);
	C = no_borrow;
	ACC = (difference & mask) | (shifted & ~mask);
	P = (old_p << 1) | zext(no_borrow);
	flagnz(ACC);
}

# Analyzer-selected canonical form for the complete manual division idiom.
# The analyzer proves ACC=0, RPT #31, an unchanged nonzero register divisor,
# a current P dividend snapshot, straight-line/exclusive ingress, and no alias.
# One constructor therefore exposes exactly the 32-step unsigned quotient and
# remainder data flow while preserving the final documented C/N/Z state.
:subcul ACC, loc32 is subcul_div32=1 & ctx_objmode=1 & op0_16=0b0101011000010111; op8_8=0b00000000 & ACC & loc32 {
	local dividend:4 = P;
	local divisor:4 = loc32;
	local quotient:4 = dividend / divisor;
	local remainder:4 = dividend % divisor;
	P = quotient;
	ACC = remainder;
	C = quotient[0,1];
	flagnz(ACC);
}

