# p.334
:neg ACC is op0_16=0b1111111101010100 & ACC {
	local start_acc:4 = ACC;
	local minimum:1 = start_acc == 0x80000000;
	local saturate:1 = minimum && (OVM != 0);
	local saturate_mask:4 = 0 - zext(saturate);
	local negated:4 = -start_acc;
	ACC = (negated & ~saturate_mask) | (0x7fffffff & saturate_mask);
	V = V || minimum;
	C = (ACC == 0);
	flagnz(ACC);
}

# p.335
:neg ax0 is op1_15=0b111111110101110 & ax0 {
	local start_ax:2 = ax0;
	local minimum:1 = start_ax == 0x8000;
	ax0 = -start_ax;
	V = V || minimum;
	C = (ax0 == 0);
	N = ax0[15,1];
	Z = (ax0 == 0);
}

# p.336
:neg64 ACC:P is ctx_objmode=1 & op0_16=0b0101011001011000 & ACC & P {
	local start_value:8 = (zext(ACC) << 32) | zext(P);
	local minimum:1 = start_value == 0x8000000000000000;
	local saturate:1 = minimum && (OVM != 0);
	local saturate_mask:8 = 0 - zext(saturate);
	local negated:8 = -start_value;
	local value:8 = (negated & ~saturate_mask) | (0x7fffffffffffffff & saturate_mask);
	ACC = value[32,32];
	P = value[0,32];
	V = V || minimum;
	C = (value == 0);
	N = value[63,1];
	Z = (value == 0);
}

# p.337
:negtc ACC is ctx_objmode=1 & op0_16=0b0101011000110010 & ACC {
	local start_acc:4 = ACC;
	local old_c:1 = C;
	local execute:1 = TC != 0;
	local minimum:1 = start_acc == 0x80000000;
	local saturate:1 = execute && minimum && (OVM != 0);
	local saturate_mask:4 = 0 - zext(saturate);
	local executed:4 = ((-start_acc) & ~saturate_mask) | (0x7fffffff & saturate_mask);
	local execute_mask:4 = 0 - zext(execute);
	ACC = (start_acc & ~execute_mask) | (executed & execute_mask);
	V = V || (execute && minimum);
	C = (old_c && !execute) || (execute && (ACC == 0));
	flagnz(ACC);
}

